function isValidCommunityTopic(data) {
return data.name is string
&& data.name.size() > 0
&& data.name.size() <= 80
&& data.slug is string
&& data.slug.size() > 0
&& data.slug.size() <= 80
&& data.active is bool
&& data.get("sortOrder", 0) is number;
}
match /communityTopics/{topicId} {
