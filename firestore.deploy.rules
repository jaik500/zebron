match /reactions/{userId} {
allow get, list: if isOpenOrganizationBlogPost(organizationId, postId);
allow create, update: if isCurrentUser(userId)
&& isOpenOrganizationBlogPost(organizationId, postId)
&& isValidBlogReaction(userId);
allow delete: if isCurrentUser(userId);
}
}
function isPublishedPlatformCourse(courseId) {
return get(/databases/$(database)/documents/courses/$(courseId)).data.status == "published";
}
function hasActiveCoursesEntitlement(organizationId) {
let entitlementPath =
/databases/$(database)/documents/organizations/$(organizationId)/applications/courses;
return exists(entitlementPath)
&& get(entitlementPath).data.get("status", "") == "active";
}
function isOpenOrganizationCourse(organizationId, courseId) {
return isPlatformAdmin()
|| (
isOrganizationOperational(organizationId)
&& hasActiveCoursesEntitlement(organizationId)
&& isOrganizationStaffOrAbove(organizationId)
)
|| (
isOrganizationOperational(organizationId)
&& hasActiveCoursesEntitlement(organizationId)
&& isOrganizationMember(organizationId)
&& get(/databases/$(database)/documents/organizations/$(organizationId)/courses/$(courseId)).data.status == "published"
);
