|| (
trainingGroupsOpen(organizationId)
&& isOrganizationStaffOrAbove(organizationId)
);
allow write: if false;
}
function pollIsVisibleScope(poll) {
return poll.contextType == "community"
? canSeeCommunityScope(poll.get("organizationId", null))
: (
poll.contextType == "live"
&& poll.get("organizationId", null) is string
&& (
isPlatformAdmin()
|| (
isOrganizationOperational(poll.organizationId)
&& hasActiveVirtualClassroom(poll.organizationId)
&& isOrganizationMember(poll.organizationId)
)
)
);
}
function canRunPoll(poll) {
return isAuthenticated()
&& (
poll.contextType == "community"
? (
(
poll.createdBy == request.auth.uid
&& canSeeCommunityScope(poll.get("organizationId", null))
)
|| canModerateCommunityScope(poll.get("organizationId", null))
)
: (
poll.contextType == "live"
&& poll.get("organizationId", null) is string
&& canRunLiveSessions(poll.organizationId)
)
);
}
function pollIsClosed(poll) {
return poll.status == "closed"
|| (
poll.get("closesAt", null) != null
&& request.time >= poll.closesAt
);
}
function canSeePollResults(pollId) {
let poll = get(/databases/$(database)/documents/polls/$(pollId)).data;
return pollIsVisibleScope(poll)
&& (
canRunPoll(poll)
|| pollIsClosed(poll)
|| (
poll.resultsVisibility == "afterVote"
&& isAuthenticated()
&& exists(/databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid))
)
|| (
poll.resultsVisibility == "host"
&& poll.status != "draft"
&& poll.get("showResults", false) == true
)
);
}
function validPollOption(options, i) {
return options.size() <= i
|| (
options[i] is map
&& options[i].keys().hasOnly(["id", "text"])
&& options[i].id is string
&& options[i].id.size() > 0
&& options[i].id.size() <= 8
&& options[i].text is string
&& options[i].text.size() > 0
&& options[i].text.size() <= 120
);
}
function isValidPoll(data) {
return data.keys().hasOnly([
"contextType", "organizationId", "parentId", "question", "options",
"allowMultiple", "maxChoices", "status", "resultsVisibility",
"showResults", "closesAt", "createdBy", "createdByName",
"createdAt", "updatedAt"
])
&& data.contextType in ["community", "live"]
&& (data.organizationId == null || data.organizationId is string)
&& data.parentId is string
&& data.parentId.size() > 0
&& data.parentId.size() <= 128
&& data.question is string
&& data.question.size() > 0
&& data.question.size() <= 300
&& data.options is list
&& data.options.size() >= 2
&& data.options.size() <= 10
&& validPollOption(data.options, 0)
&& validPollOption(data.options, 1)
&& validPollOption(data.options, 2)
&& validPollOption(data.options, 3)
&& validPollOption(data.options, 4)
&& validPollOption(data.options, 5)
&& validPollOption(data.options, 6)
&& validPollOption(data.options, 7)
&& validPollOption(data.options, 8)
&& validPollOption(data.options, 9)
&& data.allowMultiple is bool
&& data.maxChoices is int
&& data.maxChoices >= 1
&& data.maxChoices <= data.options.size()
&& (data.allowMultiple || data.maxChoices == 1)
&& data.status in ["draft", "open", "closed"]
&& data.resultsVisibility in ["afterVote", "host"]
&& data.showResults is bool
&& (data.closesAt == null || data.closesAt is timestamp)
&& data.createdBy is string
&& data.createdByName is string
&& data.createdByName.size() <= 120;
}
match /polls/{pollId} {
allow get: if pollIsVisibleScope(resource.data)
&& (resource.data.status != "draft" || canRunPoll(resource.data));
allow list: if pollIsVisibleScope(resource.data)
&& (resource.data.status in ["open", "closed"] || canRunPoll(resource.data));
allow create: if isAuthenticated()
&& isValidPoll(request.resource.data)
&& request.resource.data.createdBy == request.auth.uid
&& request.resource.data.createdAt == request.time
&& request.resource.data.updatedAt == request.time
&& request.resource.data.showResults == false
&& (
request.resource.data.contextType == "community"
? (
request.resource.data.status == "open"
&& request.resource.data.resultsVisibility == "afterVote"
&& canSeeCommunityScope(request.resource.data.organizationId)
)
: (
request.resource.data.status in ["draft", "open"]
&& request.resource.data.resultsVisibility == "host"
&& request.resource.data.organizationId is string
&& canRunLiveSessions(request.resource.data.organizationId)
)
);
allow update: if canRunPoll(resource.data)
&& request.resource.data.diff(resource.data).affectedKeys()
.hasOnly(["status", "showResults", "closesAt", "updatedAt"])
&& (
request.resource.data.status == resource.data.status
|| request.resource.data.status in ["open", "closed"]
)
&& request.resource.data.showResults is bool
&& (request.resource.data.closesAt == null || request.resource.data.closesAt is timestamp)
&& request.resource.data.updatedAt == request.time;
allow delete: if canRunPoll(resource.data);
match /results/{documentId} {
allow get: if documentId == "summary" && canSeePollResults(pollId);
allow list, write: if false;
}
match /votes/{userId} {
allow get: if isCurrentUser(userId);
allow list, write: if false;
}
}
function dashboardRoleNames() {
return ["org_member", "org_staff", "org_manager", "org_admin", "org_owner"];
}
function isValidDashboard(organizationId) {
let data = request.resource.data;
return data.keys().hasOnly([
"organizationId", "name", "description", "appId", "scope", "ownerId",
"viewMinRole", "viewMinRank", "editMinRole", "editMinRank", "isDefault",
"widgets", "templateId", "templateVersion", "createdAt", "updatedAt", "updatedBy"
])
&& data.organizationId == organizationId
&& data.name is string
&& data.name.size() > 0
&& data.name.size() <= 80
&& data.description is string
&& data.description.size() <= 300
&& data.appId is string
&& data.appId.size() > 0
&& data.appId.size() <= 40
&& data.scope == "shared"
&& data.ownerId is string
&& data.viewMinRole in dashboardRoleNames()
&& data.editMinRole in dashboardRoleNames()
&& data.viewMinRank == organizationRoleRank(data.viewMinRole)
&& data.editMinRank == organizationRoleRank(data.editMinRole)
&& data.editMinRank >= 3
&& data.editMinRank >= data.viewMinRank
&& data.isDefault is bool
&& data.widgets is list
&& data.widgets.size() <= 12
&& data.templateId is string
&& data.templateId.size() <= 64
&& data.templateVersion is int
&& data.updatedBy == request.auth.uid
&& data.updatedAt == request.time;
}
match /organizations/{organizationId}/dashboards/{dashboardId} {
allow get, list: if isPlatformAdmin()
|| (
isOrganizationOperational(organizationId)
&& isOrganizationMember(organizationId)
&& resource.data.viewMinRank <= organizationRankOf(organizationId)
);
allow create: if isAuthenticated()
&& isValidDashboard(organizationId)
&& request.resource.data.ownerId == request.auth.uid
&& request.resource.data.createdAt == request.time
&& (
isPlatformAdmin()
|| (
isOrganizationOperational(organizationId)
&& isOrganizationManagerOrAbove(organizationId)
&& request.resource.data.editMinRank <= organizationRankOf(organizationId)
)
)
&& (request.resource.data.isDefault == false || isOrganizationAdmin(organizationId));
allow update: if isAuthenticated()
&& isValidDashboard(organizationId)
&& request.resource.data.createdAt == resource.data.createdAt
&& request.resource.data.ownerId == resource.data.ownerId
&& request.resource.data.appId == resource.data.appId
&& (
isPlatformAdmin()
|| (
isOrganizationOperational(organizationId)
&& isOrganizationManagerOrAbove(organizationId)
&& resource.data.editMinRank <= organizationRankOf(organizationId)
&& request.resource.data.editMinRank <= organizationRankOf(organizationId)
)
)
&& (
request.resource.data.isDefault == resource.data.isDefault
|| isOrganizationAdmin(organizationId)
);
allow delete: if isPlatformAdmin()
|| (
isOrganizationOperational(organizationId)
&& isOrganizationManagerOrAbove(organizationId)
&& resource.data.editMinRank <= organizationRankOf(organizationId)
);
}
match /organizations/{organizationId}/stats/{appId} {
allow get: if isPlatformAdmin()
|| (
isOrganizationOperational(organizationId)
&& isOrganizationManagerOrAbove(organizationId)
);
allow list, write: if false;
}
match /certificates/{code} {
allow get: if true;
allow list, write: if false;
}
match /certifications/{certificationId} {
allow get, list: if resource.data.get("status", "") == "published"
|| isPlatformAdmin();
allow write: if isPlatformAdmin();
}
match /organizations/{organizationId}/certifications/{certificationId} {
allow get, list: if isPlatformAdmin()
|| (
isOrganizationOperational(organizationId)
&& hasActiveCoursesEntitlement(organizationId)
&& isOrganizationStaffOrAbove(organizationId)
)
|| (
isAuthenticated()
&& isOrganizationOperational(organizationId)
&& hasActiveCoursesEntitlement(organizationId)
&& isOrganizationMember(organizationId)
&& resource.data.get("status", "") == "published"
);
allow write: if canWriteOrganizationCourses(organizationId);
}
match /users/{userId}/certifications/{certificationKey} {
allow get, list: if isCurrentUser(userId)
|| isPlatformAdmin();
allow write: if false;
match /attempts/{attemptId} {
allow get, list: if isCurrentUser(userId)
|| isPlatformAdmin();
allow write: if false;
}
}
match /users/{userId}/courseExams/{progressId} {
allow get, list: if isCurrentUser(userId)
|| isPlatformAdmin();
allow write: if false;
match /attempts/{attemptId} {
allow get, list: if isCurrentUser(userId)
|| isPlatformAdmin();
allow write: if false;
}
}
match /users/{userId}/hiddenCourses/{progressId} {
allow read: if isCurrentUser(userId);
allow create, update: if isCurrentUser(userId)
&& request.resource.data.keys().hasOnly(["hiddenAt"])
&& request.resource.data.hiddenAt == request.time;
allow delete: if isCurrentUser(userId);
}
match /users/{userId}/courseProgress/{progressId} {
allow get, list: if isCurrentUser(userId)
|| isPlatformAdmin();
allow write: if false;
}
match /outboundMessages/{messageId} {
allow get, list: if isPlatformAdmin();
allow create, update, delete: if false;
}
function hasActiveBusinessOperations(organizationId) {
let entitlementPath =
/databases/$(database)/documents/organizations/$(organizationId)/applications/business-operations;
return exists(entitlementPath)
&& get(entitlementPath).data.get("status", "") == "active";
}
function canManageOrganizationBusiness(organizationId) {
return isPlatformAdmin()
|| (
isOrganizationOperational(organizationId)
&& hasActiveBusinessOperations(organizationId)
&& isOrganizationManagerOrAbove(organizationId)
);
}
function businessOptionalText(data, field, max) {
return data.get(field, null) == null
|| (data[field] is string && data[field].size() <= max);
}
function businessRequiredText(data, field, max) {
return data.get(field, null) is string
&& data[field].size() > 0
&& data[field].size() <= max;
}
function isValidBusiness(data) {
return data.keys().hasOnly([
"id", "ownerId", "legalName", "tradeName", "entityType", "stateOfFormation",
"formationDate", "ein", "registrationNumber", "industry", "naicsCode",
"locationId", "address", "status", "createdAt", "updatedAt"
])
&& businessRequiredText(data, "legalName", 200)
&& businessRequiredText(data, "entityType", 80)
&& businessOptionalText(data, "tradeName", 200)
&& businessOptionalText(data, "ein", 20)
&& data.status in ["active", "inactive", "closed"]
&& (data.get("address", null) == null || data.address is map);
}
function isValidBusinessTransaction(data) {
return data.keys().hasOnly([
"id", "businessId", "type", "date", "amount", "categoryId", "description",
"customerId", "vendorId", "paymentMethod", "referenceNumber", "accountId",
"status", "recurring", "taxDeductible", "documentId", "activityId", "notes",
"createdBy", "createdAt", "updatedAt"
])
&& data.type in ["revenue", "expense"]
&& data.amount is number
&& data.amount >= 0
&& data.status in ["pending", "completed", "void", "refunded"]
&& businessOptionalText(data, "description", 1000)
&& businessOptionalText(data, "notes", 4000);
}
function isValidBusinessActivity(data) {
return data.keys().hasOnly([
"id", "businessId", "name", "category", "description", "startDate",
"endDate", "status", "createdAt", "updatedAt"
])
&& businessRequiredText(data, "name", 200)
&& data.status in ["planned", "active", "inactive"]
&& businessOptionalText(data, "description", 4000);
}
function isValidBusinessCompliance(data) {
return data.keys().hasOnly([
"id", "businessId", "name", "category", "jurisdiction", "authority",
"dueDate", "renewalDate", "status", "notes", "documentId", "completedDate",
"automaticMonitoring", "createdAt", "updatedAt"
])
&& businessRequiredText(data, "name", 200)
&& data.status in ["current", "upcoming", "action_required", "overdue", "expired", "not_applicable"]
&& businessOptionalText(data, "notes", 4000);
}
function isValidBusinessDocument(data, folder) {
return data.keys().hasOnly([
"id", "businessId", "name", "category", "description", "fileName", "mimeType",
"sizeBytes", "storagePath", "downloadUrl", "uploadedBy", "uploadedAt",
"expiresAt", "verified", "status", "notes", "createdAt", "updatedAt"
])
&& businessRequiredText(data, "name", 200)
&& data.storagePath is string
&& data.storagePath.matches(folder + "/" + data.businessId + "/[^/]+")
&& data.status in ["active", "archived"]
&& businessOptionalText(data, "notes", 4000);
}
function organizationBusinessExists(organizationId, businessId) {
return businessId is string
&& exists(/databases/$(database)/documents/organizations/$(organizationId)/businesses/$(businessId));
}
match /organizations/{organizationId}/businesses/{businessId} {
allow read, delete: if canManageOrganizationBusiness(organizationId);
allow create, update: if canManageOrganizationBusiness(organizationId)
&& isValidBusiness(request.resource.data);
}
match /organizations/{organizationId}/businessTransactions/{recordId} {
allow read, delete: if canManageOrganizationBusiness(organizationId);
allow create, update: if canManageOrganizationBusiness(organizationId)
&& isValidBusinessTransaction(request.resource.data)
&& organizationBusinessExists(organizationId, request.resource.data.businessId);
}
match /organizations/{organizationId}/businessActivities/{recordId} {
allow read, delete: if canManageOrganizationBusiness(organizationId);
allow create, update: if canManageOrganizationBusiness(organizationId)
&& isValidBusinessActivity(request.resource.data)
&& organizationBusinessExists(organizationId, request.resource.data.businessId);
}
match /organizations/{organizationId}/businessCompliance/{recordId} {
allow read, delete: if canManageOrganizationBusiness(organizationId);
allow create, update: if canManageOrganizationBusiness(organizationId)
&& isValidBusinessCompliance(request.resource.data)
&& organizationBusinessExists(organizationId, request.resource.data.businessId);
}
match /organizations/{organizationId}/businessDocuments/{recordId} {
allow read, delete: if canManageOrganizationBusiness(organizationId);
allow create, update: if canManageOrganizationBusiness(organizationId)
&& isValidBusinessDocument(
request.resource.data,
"organizations/" + organizationId + "/business-documents"
)
&& organizationBusinessExists(organizationId, request.resource.data.businessId);
}
function platformBusinessExists(businessId) {
return businessId is string
&& exists(/databases/$(database)/documents/businesses/$(businessId));
}
match /businesses/{businessId} {
allow read, delete: if isPlatformAdmin();
allow create, update: if isPlatformAdmin()
&& isValidBusiness(request.resource.data);
}
match /businessTransactions/{recordId} {
allow read, delete: if isPlatformAdmin();
allow create, update: if isPlatformAdmin()
&& isValidBusinessTransaction(request.resource.data)
&& platformBusinessExists(request.resource.data.businessId);
}
match /businessActivities/{recordId} {
allow read, delete: if isPlatformAdmin();
allow create, update: if isPlatformAdmin()
&& isValidBusinessActivity(request.resource.data)
&& platformBusinessExists(request.resource.data.businessId);
}
match /businessCompliance/{recordId} {
allow read, delete: if isPlatformAdmin();
allow create, update: if isPlatformAdmin()
&& isValidBusinessCompliance(request.resource.data)
&& platformBusinessExists(request.resource.data.businessId);
}
match /businessDocuments/{recordId} {
allow read, delete: if isPlatformAdmin();
allow create, update: if isPlatformAdmin()
&& isValidBusinessDocument(request.resource.data, "business-documents")
&& platformBusinessExists(request.resource.data.businessId);
}
}
}
