&& hasActiveCoursesEntitlement(organizationId)
&& isOrganizationStaffOrAbove(organizationId);
}
function isUnpublishedOrganizationCourse(organizationId, courseId) {
let coursePath = /databases/$(database)/documents/organizations/$(organizationId)/courses/$(courseId);
return (!exists(coursePath) || get(coursePath).data.status in ["draft", "in_review"])
&& (!existsAfter(coursePath) || getAfter(coursePath).data.status in ["draft", "in_review"]);
}
function courseFieldNames() {
return [
"title", "summary", "description", "topic", "program", "programOrder", "level", "cover",
"outcomes", "skills", "modules", "lessonCount", "estimatedMinutes",
"status", "providerName", "authorId", "authorName", "organizationId", "id", "finalExam",
"review", "createdAt", "updatedAt", "publishedAt"
