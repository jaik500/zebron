function validPostText(data) {
return data.title is string
&& data.title.size() > 0
&& data.title.size() <= 200
&& data.content is string
&& data.content.size() > 0
&& data.content.size() <= 10000
&& data.topicId is string
&& data.topicId.size() > 0
&& data.get("tags", []) is list
&& data.get("tags", []).size() <= 20
&& data.get("mediaUrls", []) is list
&& data.get("mediaUrls", []).size() <= 10;
}
function isValidNewPost() {
let data = request.resource.data;
let organizationId = data.get("organizationId", null);
return isAuthenticated()
&& data.keys().hasAll([
"authorId",
"author",
"topicId",
"title",
"content",
"status",
"moderationStatus",
"reactionCounts",
"commentCount",
"viewCount",
"organizationId",
"createdAt",
"updatedAt"
])
&& data.keys().hasOnly([
"authorId",
"author",
"topicId",
"topicName",
"title",
"content",
"mediaUrls",
"tags",
"status",
"moderationStatus",
"reactionCounts",
"commentCount",
"viewCount",
"trendingScore",
"organizationId",
"pollId",
"createdAt",
"updatedAt"
])
&& data.authorId == request.auth.uid
&& (
data.get("pollId", null) == null
|| (
data.pollId is string
&& exists(/databases/$(database)/documents/polls/$(data.pollId))
&& get(/databases/$(database)/documents/polls/$(data.pollId)).data.contextType == "community"
&& get(/databases/$(database)/documents/polls/$(data.pollId)).data.createdBy == request.auth.uid
&& get(/databases/$(database)/documents/polls/$(data.pollId)).data.parentId == postId
)
)
&& data.author is map
&& data.author.get("id", "") == request.auth.uid
&& validPostText(data)
&& data.status == "published"
&& data.moderationStatus == "approved"
&& data.reactionCounts is map
&& data.commentCount == 0
&& data.viewCount == 0
&& data.get("trendingScore", 0) == 0
&& data.createdAt == request.time
&& (organizationId == null || organizationId is string)
&& canSeeCommunityScope(organizationId);
}
function isAuthorEditingPost() {
return isAuthenticated()
&& resource.data.get("authorId", "") == request.auth.uid
&& resource.data.get("status", "") == "published"
&& canSeeCommunityScope(postScope())
&& request.resource.data.diff(resource.data).affectedKeys()
.hasOnly([
"title",
"content",
"tags",
"topicId",
"topicName",
"mediaUrls",
"editedAt",
"updatedAt"
])
&& validPostText(request.resource.data);
