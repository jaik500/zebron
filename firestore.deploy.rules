match /bootcampStats/{statId} {
function addsOne(field) {
return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
&& request.resource.data[field] == resource.data[field] + 1;
}
allow read, delete: if isPlatformAdmin();
allow create: if request.resource.data.keys().hasOnly(["bootcampId", "programId", "views", "applyClicks"])
&& request.resource.data.bootcampId is string
&& request.resource.data.programId is string
&& statId == request.resource.data.bootcampId + "__" + request.resource.data.programId
&& request.resource.data.views in [0, 1]
&& request.resource.data.applyClicks in [0, 1]
&& request.resource.data.views + request.resource.data.applyClicks == 1
&& exists(/databases/$(database)/documents/resources/$(request.resource.data.bootcampId));
allow update: if addsOne("views") || addsOne("applyClicks");
}
match /users/{userId}/codeLabProjects/{projectId} {
allow read, delete: if isCurrentUser(userId);
allow create, update: if isCurrentUser(userId)
&& request.resource.data.keys().hasOnly(["name", "language", "code", "updatedAt"])
&& request.resource.data.name is string
&& request.resource.data.name.size() <= 80
&& request.resource.data.language in ["javascript", "python", "web"]
&& request.resource.data.code is string
&& request.resource.data.code.size() <= 50000
&& request.resource.data.updatedAt == request.time;
}
match /users/{userId}/codeLabExercises/{exerciseId} {
allow read, delete: if isCurrentUser(userId);
allow create, update: if isCurrentUser(userId)
&& request.resource.data.keys().hasOnly(["key", "language", "code", "passed", "passedAt", "updatedAt"])
&& request.resource.data.key is string
&& request.resource.data.key.size() <= 300
&& request.resource.data.language in ["javascript", "python", "web"]
&& request.resource.data.code is string
&& request.resource.data.code.size() <= 50000
&& request.resource.data.passed is bool
&& (!("passedAt" in request.resource.data) || request.resource.data.passedAt is timestamp)
&& request.resource.data.updatedAt == request.time;
}
function validCareerPath(data) {
return data.keys().hasOnly([
"title", "summary", "description", "field", "level", "salaryRange",
"outlook", "jobKeywords", "skills", "stages", "status", "order",
"createdAt", "updatedAt"
])
&& data.title is string && data.title.size() > 0 && data.title.size() <= 120
&& data.summary is string && data.summary.size() <= 240
&& data.description is string && data.description.size() <= 3000
&& data.field is string && data.field.size() <= 60
&& data.level in ["entry", "mid", "senior"]
&& data.salaryRange is string && data.salaryRange.size() <= 120
&& data.outlook is string && data.outlook.size() <= 400
&& data.jobKeywords is string && data.jobKeywords.size() <= 100
&& data.skills is list && data.skills.size() <= 20
&& data.stages is list && data.stages.size() <= 10
&& data.status in ["draft", "published"]
&& data.order is int && data.order >= 0 && data.order <= 10000
&& data.updatedAt == request.time;
}
match /careerPaths/{pathId} {
allow get, list: if resource.data.status == "published"
|| isPlatformAdmin();
allow create: if isPlatformAdmin()
&& pathId.matches('^[a-z0-9-]{1,60}$')
&& validCareerPath(request.resource.data)
&& request.resource.data.createdAt == request.time;
allow update: if isPlatformAdmin()
&& validCareerPath(request.resource.data)
&& request.resource.data.createdAt == resource.data.createdAt;
allow delete: if isPlatformAdmin();
}
match /users/{userId}/careerPlans/{pathId} {
allow read, delete: if isCurrentUser(userId);
allow create: if isCurrentUser(userId)
&& request.resource.data.keys().hasOnly(["pathId", "pathTitle", "completedStepIds", "startedAt", "updatedAt"])
&& request.resource.data.pathId == pathId
&& request.resource.data.pathTitle is string
&& request.resource.data.pathTitle.size() <= 200
&& request.resource.data.completedStepIds is list
&& request.resource.data.completedStepIds.size() <= 200
&& request.resource.data.startedAt == request.time
&& request.resource.data.updatedAt == request.time
&& exists(/databases/$(database)/documents/careerPaths/$(pathId));
allow update: if isCurrentUser(userId)
&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pathTitle", "completedStepIds", "updatedAt"])
&& request.resource.data.pathTitle is string
&& request.resource.data.pathTitle.size() <= 200
&& request.resource.data.completedStepIds is list
&& request.resource.data.completedStepIds.size() <= 200
&& request.resource.data.updatedAt == request.time;
}
function validCareerProjectWork(data) {
return data.url is string
&& data.url.matches('^https://.{1,490}$')
&& data.notes is string && data.notes.size() <= 2000
&& data.learnerName is string && data.learnerName.size() <= 120;
}
match /careerProjects/{projectId} {
allow get, list: if isPlatformAdmin()
|| (isAuthenticated() && resource.data.userId == request.auth.uid);
allow create: if isAuthenticated()
&& request.resource.data.keys().hasOnly([
"userId", "learnerName", "pathId", "pathTitle", "stepId", "stepTitle",
"url", "notes", "status", "feedback", "reviewerId", "reviewedAt",
"submittedAt", "updatedAt"
])
&& request.resource.data.userId == request.auth.uid
&& request.resource.data.pathId is string
&& request.resource.data.stepId is string
&& projectId == request.auth.uid + "__" + request.resource.data.pathId + "__" + request.resource.data.stepId
