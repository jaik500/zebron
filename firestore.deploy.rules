&& data.get("skills", []).size() <= 30
&& (
data.get("finalExam", null) == null
|| (
data.finalExam is map
&& data.finalExam.keys().hasOnly(["quizId", "quizName", "questionCount", "passMark", "timeLimitMinutes", "maxAttempts"])
