allow create, update: if isPlatformAdmin()
&& configId == "settings"
&& request.resource.data.keys().hasOnly([
"enabled", "monthlyCallLimit", "userDailyLimit", "model",
"inputCostPerMillion", "outputCostPerMillion",
"learnerDailyLimit", "learnerMonthlyLimit", "updatedAt"
])
&& request.resource.data.get("learnerDailyLimit", 0) is int
&& request.resource.data.get("learnerMonthlyLimit", 0) is int
&& request.resource.data.enabled is bool
&& request.resource.data.monthlyCallLimit is int
&& request.resource.data.userDailyLimit is int
&& request.resource.data.model is string
&& request.resource.data.model.size() <= 70
&& request.resource.data.inputCostPerMillion is number
&& request.resource.data.outputCostPerMillion is number;
allow delete: if false;
}
