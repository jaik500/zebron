rules_version = '2';

// Zebron Cloud Storage rules.
//
// Everything is denied unless a rule below allows it. The previous
// starter rules expired on 17 September 2026, which blocked every
// upload and download.
//
// Paths in use:
//   communityChat/{conversationId}/attachments/{file}   chat attachments
//   organizations/{organizationId}/business-documents/{businessId}/{file}
//                                                       an organization's Business Operations documents
//   business-documents/{businessId}/{file}              Zebron's own Business Operations documents
//   blog-images/{file}                                  photos in public and staff blog posts
//   organizations/{organizationId}/blog-images/{file}   photos in an organization's blog posts
//   organizations/{organizationId}/trainingGroups/{groupId}/assignments/{assignmentId}/materials/{file}
//                                                       files an instructor attaches to an assignment
//   organizations/{organizationId}/trainingGroups/{groupId}/assignments/{assignmentId}/submissions/{userId}/{file}
//                                                       files a learner hands in
//   organizations/{organizationId}/branding/{file}      the organization's dashboard logo
//   users/{userId}/avatar/{file}                        a person's profile photo
//   users/{userId}/documents/{documentId}/{file}        a person's own documents (My documents reader)
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Roles on the sign-in token (see firestore.rules): when synced, the
    // token decides without a billed Firestore lookup. Otherwise the same
    // definition as Firestore rules: platformRole "platform-admin", or the
    // legacy role "admin" when platformRole is absent.
    function isPlatformAdmin() {
      return signedIn()
        && (
          request.auth.token.get("zv", 0) == 1
            ? request.auth.token.get("zpa", false) == true
            : (
              firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
              && (
                userProfile().get("platformRole", "") == "platform-admin"
                || (
                  !userProfile().keys().hasAny(["platformRole"])
                  && userProfile().get("role", "") == "admin"
                )
              )
            )
        );
    }

    // ------------------------------------------------------------
    // COMMUNITY CHAT ATTACHMENTS
    // ------------------------------------------------------------
    // Only the two people in the conversation can upload, open or
    // delete its attachments. Uploads up to 50 MB (the app's limit).
    match /communityChat/{conversationId}/attachments/{fileName} {

      function isParticipant() {
        return signedIn()
          && firestore.exists(/databases/(default)/documents/communityConversations/$(conversationId))
          && request.auth.uid in firestore.get(
            /databases/(default)/documents/communityConversations/$(conversationId)
          ).data.participantIds;
      }

      allow read: if isParticipant();

      allow create: if isParticipant()
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024;

      allow update: if false;

      // Used to clean up an upload when sending the message fails.
      allow delete: if isParticipant();
    }

    // ------------------------------------------------------------
    // BUSINESS OPERATIONS DOCUMENTS
    // ------------------------------------------------------------
    // The same people as the Firestore records (see firestore.rules,
    // BUSINESS OPERATIONS): an organization's managers and above while
    // its business-operations app is active, and platform administrators.
    // Uploads up to 25 MB.
    function organizationRoleRank(role) {
      return {
        "org_member": 1,
        "org_staff": 2,
        "org_manager": 3,
        "org_admin": 4,
        "org_owner": 5
      }.get(role, 0);
    }

    // Role from the sign-in token when synced, otherwise from the
    // active membership document ({uid}_{organizationId}).
    function organizationRank(organizationId) {
      let membershipPath =
        /databases/(default)/documents/organizationMemberships/$(request.auth.uid + "_" + organizationId);

      return request.auth.token.get("zv", 0) == 1
          && request.auth.token.get("zorg", {}).get(organizationId, "") != ""
        ? organizationRoleRank(request.auth.token.get("zorg", {}).get(organizationId, ""))
        : (
          firestore.exists(membershipPath)
            && firestore.get(membershipPath).data.get("active", false) == true
            ? organizationRoleRank(firestore.get(membershipPath).data.get("role", ""))
            : 0
        );
    }

    function canManageOrganizationBusiness(organizationId) {
      let organizationPath = /databases/(default)/documents/organizations/$(organizationId);
      let entitlementPath =
        /databases/(default)/documents/organizations/$(organizationId)/applications/business-operations;

      return signedIn()
        && (
          isPlatformAdmin()
          || (
            firestore.exists(organizationPath)
            && firestore.get(organizationPath).data.get(
              "status",
              firestore.get(organizationPath).data.get("active", true) == true ? "active" : "suspended"
            ) == "active"
            && firestore.exists(entitlementPath)
            && firestore.get(entitlementPath).data.get("status", "") == "active"
            && organizationRank(organizationId) >= 3
          )
        );
    }

    match /organizations/{organizationId}/business-documents/{businessId}/{fileName} {
      allow read, delete: if canManageOrganizationBusiness(organizationId);

      allow create, update: if canManageOrganizationBusiness(organizationId)
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
    }

    match /business-documents/{businessId}/{fileName} {
      allow read, delete: if isPlatformAdmin();

      allow create, update: if isPlatformAdmin()
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
    }

    // ------------------------------------------------------------
    // BLOG IMAGES
    // ------------------------------------------------------------
    // Cover photos, pictures and short video clips in posts: images up
    // to 5 MB and MP4/WebM videos up to 50 MB (the editor's limits).
    // Files are never replaced, only added.
    function isBlogImage() {
      return request.resource.size > 0
        && (
          (request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'))
          || (request.resource.size <= 50 * 1024 * 1024
            && request.resource.contentType.matches('video/(mp4|webm)'))
        );
    }

    // Public and staff posts: anyone can see the pictures, Zebron
    // platform administrators (who write those posts) upload them.
    match /blog-images/{fileName} {
      allow read: if true;
      allow create: if isPlatformAdmin() && isBlogImage();
      allow update: if false;
      allow delete: if isPlatformAdmin();
    }

    // ------------------------------------------------------------
    // HOME PAGE LOOKS (Admin -> Home page look builder)
    // ------------------------------------------------------------
    // The picture placed on the "e" in the Zebron name: anyone can see
    // it (the home page shows it), platform administrators upload PNG,
    // WebP or SVG pictures up to 1 MB. Never replaced, only added.
    match /home-looks/{lookId}/{fileName} {
      allow read: if true;
      allow create: if isPlatformAdmin()
        && request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType.matches('image/(png|webp|svg[+]xml)');
      allow update: if false;
      allow delete: if isPlatformAdmin();
    }

    // An organization's posts: its members can see the pictures, its
    // staff and above (who write posts) upload them, managers remove them.
    match /organizations/{organizationId}/blog-images/{fileName} {
      allow read: if signedIn() && (isPlatformAdmin() || organizationRank(organizationId) >= 1);
      allow create: if signedIn() && (isPlatformAdmin() || organizationRank(organizationId) >= 2) && isBlogImage();
      allow update: if false;
      allow delete: if signedIn() && (isPlatformAdmin() || organizationRank(organizationId) >= 3);
    }

    // ------------------------------------------------------------
    // PROFILE PHOTOS
    // ------------------------------------------------------------
    // Shown on the person's profile, in the header and in Community, so
    // any signed-in user can see them. Only the person uploads or removes
    // their own. The app crops and shrinks them to 256 px first, so 1 MB
    // is plenty. PNG, JPEG or WebP only (SVG can carry scripts).
    match /users/{userId}/avatar/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 1 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow update: if false;
      allow delete: if signedIn() && (request.auth.uid == userId || isPlatformAdmin());
    }

    // ------------------------------------------------------------
    // MY DOCUMENTS
    // ------------------------------------------------------------
    // A person's own files for the reader (/courses/documents). Private:
    // only the owner opens, uploads or deletes them. Up to 50 MB; PDF,
    // EPUB, Word, plain text or markdown (the app sets the type). A PDF
    // can be saved over itself when its form is filled in.
    match /users/{userId}/documents/{documentId}/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/epub[+]zip|application/vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document|text/plain|text/markdown');
      // A PDF saved again with its form filled in (the reader's Save): PDFs only.
      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.contentType == 'application/pdf'
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024;
    }

    // ------------------------------------------------------------
    // ORGANIZATION LOGO
    // ------------------------------------------------------------
    // Shown on the organization dashboard. Members can see it; owners,
    // administrators and platform administrators upload and remove it.
    // The app shrinks it to 256 px before upload, so 1 MB is plenty.
    // PNG, JPEG or WebP only (SVG can carry scripts). Never replaced in
    // place: each upload is a new file and the old one is deleted.
    match /organizations/{organizationId}/branding/{fileName} {
      allow read: if signedIn() && (isPlatformAdmin() || organizationRank(organizationId) >= 1);
      allow create: if signedIn()
        && (isPlatformAdmin() || organizationRank(organizationId) >= 4)
        && request.resource.size > 0
        && request.resource.size <= 1 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow update: if false;
      allow delete: if signedIn() && (isPlatformAdmin() || organizationRank(organizationId) >= 4);
    }

    // ------------------------------------------------------------
    // TRAINING GROUP ASSIGNMENTS
    // ------------------------------------------------------------
    // The same people as the Firestore records (see firestore.rules,
    // TRAINING GROUPS): the group's staff (managers and above, and its
    // leads and instructors who are staff or above), and its members.
    // Files up to 25 MB; the Cloud Functions record them on the
    // assignment or submission.
    function trainingGroupsActive(organizationId) {
      let entitlementPath =
        /databases/(default)/documents/organizations/$(organizationId)/applications/training-groups;

      return firestore.exists(entitlementPath)
        && firestore.get(entitlementPath).data.get("status", "") == "active";
    }

    function isTrainingGroupStaff(organizationId, groupId) {
      let groupPath = /databases/(default)/documents/organizations/$(organizationId)/trainingGroups/$(groupId);

      return organizationRank(organizationId) >= 3
        || (
          organizationRank(organizationId) >= 2
          && firestore.exists(groupPath)
          && (
            firestore.get(groupPath).data.get("leadIds", []).hasAny([request.auth.uid])
            || firestore.get(groupPath).data.get("instructorIds", []).hasAny([request.auth.uid])
          )
        );
    }

    function isTrainingGroupMember(organizationId, groupId) {
      return organizationRank(organizationId) >= 1
        && firestore.exists(
          /databases/(default)/documents/organizations/$(organizationId)/trainingGroups/$(groupId)/members/$(request.auth.uid)
        );
    }

    function isAssignmentFile() {
      return request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
    }

    match /organizations/{organizationId}/trainingGroups/{groupId}/assignments/{assignmentId}/materials/{fileName} {
      allow read: if signedIn()
        && (
          isPlatformAdmin()
          || (
            trainingGroupsActive(organizationId)
            && (isTrainingGroupStaff(organizationId, groupId) || isTrainingGroupMember(organizationId, groupId))
          )
        );

      allow create: if signedIn()
        && (isPlatformAdmin() || (trainingGroupsActive(organizationId) && isTrainingGroupStaff(organizationId, groupId)))
        && isAssignmentFile();

      allow update: if false;

      allow delete: if signedIn()
        && (isPlatformAdmin() || (trainingGroupsActive(organizationId) && isTrainingGroupStaff(organizationId, groupId)));
    }

    match /organizations/{organizationId}/trainingGroups/{groupId}/assignments/{assignmentId}/submissions/{userId}/{fileName} {
      allow read: if signedIn()
        && (
          isPlatformAdmin()
          || (
            trainingGroupsActive(organizationId)
            && (request.auth.uid == userId || isTrainingGroupStaff(organizationId, groupId))
          )
        );

      // Learners upload only into their own folder.
      allow create: if signedIn()
        && request.auth.uid == userId
        && trainingGroupsActive(organizationId)
        && isTrainingGroupMember(organizationId, groupId)
        && isAssignmentFile();

      allow update: if false;

      // Removing a file before handing in (once handed in, the Cloud Function manages it).
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
