rules_version = '2';

// Zebron Cloud Storage rules.
//
// Everything is denied unless a rule below allows it. The previous
// starter rules expired on 17 September 2026, which blocked every
// upload and download.
//
// Paths in use:
//   communityChat/{conversationId}/attachments/{file}   chat attachments
//   qaTasks/{taskId}/documents/{file}                   QA Hub documents
//   organizations/{organizationId}/business-documents/{businessId}/{file}
//                                                       an organization's Business Operations documents
//   business-documents/{businessId}/{file}              Zebron's own Business Operations documents
//   blog-images/{file}                                  photos in public and staff blog posts
//   organizations/{organizationId}/blog-images/{file}   photos in an organization's blog posts
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Roles on the sign-in token (see firestore.rules): when synced, the
    // token decides without a billed Firestore lookup. Otherwise the same
    // definition as Firestore rules: platformRole "platform-admin", or the
    // legacy role "admin" when platformRole is absent.
    function isPlatformAdmin() {
      return signedIn()
        && (
          request.auth.token.get("zv", 0) == 1
            ? request.auth.token.get("zpa", false) == true
            : (
              firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
              && (
                userProfile().get("platformRole", "") == "platform-admin"
                || (
                  !userProfile().keys().hasAny(["platformRole"])
                  && userProfile().get("role", "") == "admin"
                )
              )
            )
        );
    }

    // ------------------------------------------------------------
    // COMMUNITY CHAT ATTACHMENTS
    // ------------------------------------------------------------
    // Only the two people in the conversation can upload, open or
    // delete its attachments. Uploads up to 50 MB (the app's limit).
    match /communityChat/{conversationId}/attachments/{fileName} {

      function isParticipant() {
        return signedIn()
          && firestore.exists(/databases/(default)/documents/communityConversations/$(conversationId))
          && request.auth.uid in firestore.get(
            /databases/(default)/documents/communityConversations/$(conversationId)
          ).data.participantIds;
      }

      allow read: if isParticipant();

      allow create: if isParticipant()
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024;

      allow update: if false;

      // Used to clean up an upload when sending the message fails.
      allow delete: if isParticipant();
    }

    // ------------------------------------------------------------
    // QA HUB DOCUMENTS
    // ------------------------------------------------------------
    // Platform administrators upload. Active testers assigned to the
    // task can open its documents.
    match /qaTasks/{taskId}/documents/{fileName} {

      function isAssignedTester() {
        return signedIn()
          && firestore.exists(/databases/(default)/documents/qaTesters/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/qaTesters/$(request.auth.uid)).data.get("active", false) == true
          && firestore.exists(/databases/(default)/documents/qaTasks/$(taskId))
          && request.auth.uid in firestore.get(/databases/(default)/documents/qaTasks/$(taskId)).data.get("assignedTesterIds", []);
      }

      allow read: if isPlatformAdmin() || isAssignedTester();

      allow create, update: if isPlatformAdmin()
        && request.resource.size <= 25 * 1024 * 1024;

      allow delete: if isPlatformAdmin();
    }

    // ------------------------------------------------------------
    // BUSINESS OPERATIONS DOCUMENTS
    // ------------------------------------------------------------
    // The same people as the Firestore records (see firestore.rules,
    // BUSINESS OPERATIONS): an organization's managers and above while
    // its business-operations app is active, and platform administrators.
    // Uploads up to 25 MB.
    function organizationRoleRank(role) {
      return {
        "org_member": 1,
        "org_staff": 2,
        "org_manager": 3,
        "org_admin": 4,
        "org_owner": 5
      }.get(role, 0);
    }

    // Role from the sign-in token when synced, otherwise from the
    // active membership document ({uid}_{organizationId}).
    function organizationRank(organizationId) {
      let membershipPath =
        /databases/(default)/documents/organizationMemberships/$(request.auth.uid + "_" + organizationId);

      return request.auth.token.get("zv", 0) == 1
          && request.auth.token.get("zorg", {}).get(organizationId, "") != ""
        ? organizationRoleRank(request.auth.token.get("zorg", {}).get(organizationId, ""))
        : (
          firestore.exists(membershipPath)
            && firestore.get(membershipPath).data.get("active", false) == true
            ? organizationRoleRank(firestore.get(membershipPath).data.get("role", ""))
            : 0
        );
    }

    function canManageOrganizationBusiness(organizationId) {
      let organizationPath = /databases/(default)/documents/organizations/$(organizationId);
      let entitlementPath =
        /databases/(default)/documents/organizations/$(organizationId)/applications/business-operations;

      return signedIn()
        && (
          isPlatformAdmin()
          || (
            firestore.exists(organizationPath)
            && firestore.get(organizationPath).data.get(
              "status",
              firestore.get(organizationPath).data.get("active", true) == true ? "active" : "suspended"
            ) == "active"
            && firestore.exists(entitlementPath)
            && firestore.get(entitlementPath).data.get("status", "") == "active"
            && organizationRank(organizationId) >= 3
          )
        );
    }

    match /organizations/{organizationId}/business-documents/{businessId}/{fileName} {
      allow read, delete: if canManageOrganizationBusiness(organizationId);

      allow create, update: if canManageOrganizationBusiness(organizationId)
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
    }

    match /business-documents/{businessId}/{fileName} {
      allow read, delete: if isPlatformAdmin();

      allow create, update: if isPlatformAdmin()
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
    }

    // ------------------------------------------------------------
    // BLOG IMAGES
    // ------------------------------------------------------------
    // Cover photos and pictures inside posts. Images only, up to 5 MB
    // (the editor's limit). Files are never replaced, only added.
    function isBlogImage() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Public and staff posts: anyone can see the pictures, Zebron
    // platform administrators (who write those posts) upload them.
    match /blog-images/{fileName} {
      allow read: if true;
      allow create: if isPlatformAdmin() && isBlogImage();
      allow update: if false;
      allow delete: if isPlatformAdmin();
    }

    // An organization's posts: its members can see the pictures, its
    // staff and above (who write posts) upload them, managers remove them.
    match /organizations/{organizationId}/blog-images/{fileName} {
      allow read: if signedIn() && (isPlatformAdmin() || organizationRank(organizationId) >= 1);
      allow create: if signedIn() && (isPlatformAdmin() || organizationRank(organizationId) >= 2) && isBlogImage();
      allow update: if false;
      allow delete: if signedIn() && (isPlatformAdmin() || organizationRank(organizationId) >= 3);
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
