rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {

// ============================================================
// COMMON HELPERS
// ============================================================

function isAuthenticated() {
  return request.auth != null;
}

function isCurrentUser(userId) {
  return isAuthenticated()
    && request.auth.uid == userId;
}

/**
 * Determine whether the authenticated user is a
 * platform administrator.
 *
 * Canonical authorization:
 *
 *   platformRole == "platform-admin"
 *
 * Legacy compatibility:
 *
 *   role == "admin"
 *
 * is only honored when platformRole does not yet exist.
 *
 * This allows existing administrator accounts to continue
 * functioning while user profiles are migrated.
 */
function isPlatformAdmin() {
  return isAuthenticated()
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && (
      get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.platformRole == "platform-admin"

      ||

      (
        !get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.keys().hasAny(["platformRole"])
        &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin"
      )
    );
}

// ============================================================
// ORGANIZATIONS
// ============================================================

match /organizations/{organizationId} {

  /*
   * Platform administrators can read any organization.
   *
   * Partner users can read only organizations for which
   * they have an active membership.
   *
   * This supports the Partner Portal organization selector
   * without allowing users to enumerate arbitrary tenants.
   */
  allow get: if isPlatformAdmin()
    || isOrganizationMember(organizationId);

  /*
   * Organization listing is intentionally restricted.
   *
   * Partner users must resolve their organizations through
   * their own organization memberships rather than querying
   * the entire organizations collection.
   */
  allow list: if isPlatformAdmin();

  /*
   * Organizations are platform-managed records.
   *
   * Partner organization administrators do not create or
   * modify organization records through the Partner Portal.
   */
  allow create: if isPlatformAdmin();

  allow update: if isPlatformAdmin();

  allow delete: if isPlatformAdmin();
}

/*
 * Organization memberships use deterministic IDs:
 *
 *   {userId}_{organizationId}
 *
 * Organization roles are namespaced separately from platform roles:
 *
 *   org_owner
 *   org_admin
 *   org_manager
 *   org_staff
 *   org_member
 */
function organizationMembershipPath(
  userId,
  organizationId
) {
  return /databases/$(database)/documents/organizationMemberships/$(userId + "_" + organizationId);
}

function isOrganizationMember(organizationId) {
  return isAuthenticated()
    && exists(
      organizationMembershipPath(
        request.auth.uid,
        organizationId
      )
    )
    && get(
      organizationMembershipPath(
        request.auth.uid,
        organizationId
      )
    ).data.active == true;
}

function isOrganizationAdmin(organizationId) {
  return isAuthenticated()
    && (
      isPlatformAdmin()
      ||
      (
        isOrganizationMember(organizationId)
        &&
        (
          get(
            organizationMembershipPath(
              request.auth.uid,
              organizationId
            )
          ).data.role == "org_owner"
          ||
          get(
            organizationMembershipPath(
              request.auth.uid,
              organizationId
            )
          ).data.role == "org_admin"
        )
      )
    );
}

function isOrganizationStaffOrAbove(
  organizationId
) {
  return isAuthenticated()
    && (
      isPlatformAdmin()
      || (
        isOrganizationMember(organizationId)
        && (
          get(
            organizationMembershipPath(
              request.auth.uid,
              organizationId
            )
          ).data.role == "org_owner"
          ||
          get(
            organizationMembershipPath(
              request.auth.uid,
              organizationId
            )
          ).data.role == "org_admin"
          ||
          get(
            organizationMembershipPath(
              request.auth.uid,
              organizationId
            )
          ).data.role == "org_manager"
          ||
          get(
            organizationMembershipPath(
              request.auth.uid,
              organizationId
            )
          ).data.role == "org_staff"
        )
      )
    );
}

function isOrganizationManagerOrAbove(
  organizationId
) {
  return isAuthenticated()
    && (
      isPlatformAdmin()
      ||
      (
        isOrganizationMember(organizationId)
        &&
        (
          get(
            organizationMembershipPath(
              request.auth.uid,
              organizationId
            )
          ).data.role == "org_owner"
          ||
          get(
            organizationMembershipPath(
              request.auth.uid,
              organizationId
            )
          ).data.role == "org_admin"
          ||
          get(
            organizationMembershipPath(
              request.auth.uid,
              organizationId
            )
          ).data.role == "org_manager"
        )
      )
    );
}

// ============================================================
// GROUP SECURITY HELPERS
// ============================================================

/*
 * Groups are organization-scoped.
 *
 * Canonical Firestore hierarchy:
 *
 *   organizations/{organizationId}/groups/{groupId}
 *     ├── members/{membershipId}
 *     ├── roles/{roleId}
 *     │   └── permissions/{permissionId}
 *     └── roleAssignments/{assignmentId}
 *
 * Group membership IDs are Firestore-generated. Rules never assume
 * a deterministic membership document ID.
 */

function groupPath(
  organizationId,
  groupId
) {
  return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId);
}

function groupExists(
  organizationId,
  groupId
) {
  return exists(
    groupPath(
      organizationId,
      groupId
    )
  );
}

function isActiveGroup(
  organizationId,
  groupId
) {
  return groupExists(
    organizationId,
    groupId
  )
  && get(
    groupPath(
      organizationId,
      groupId
    )
  ).data.active == true;
}

function groupMembershipPath(
  organizationId,
  groupId,
  membershipId
) {
  return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/members/$(membershipId);
}

function groupMembershipExists(
  organizationId,
  groupId,
  membershipId
) {
  return exists(
    groupMembershipPath(
      organizationId,
      groupId,
      membershipId
    )
  );
}

function activeGroupMembershipExists(
  organizationId,
  groupId,
  membershipId
) {
  return groupMembershipExists(
    organizationId,
    groupId,
    membershipId
  )
  && get(
    groupMembershipPath(
      organizationId,
      groupId,
      membershipId
    )
  ).data.active == true;
}

function isOwnGroupMembership(
  organizationId,
  groupId,
  membershipId
) {
  return isAuthenticated()
    && activeGroupMembershipExists(
      organizationId,
      groupId,
      membershipId
    )
    && get(
      groupMembershipPath(
        organizationId,
        groupId,
        membershipId
      )
    ).data.userId == request.auth.uid;
}

function groupRolePath(
  organizationId,
  groupId,
  roleId
) {
  return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/roles/$(roleId);
}

function groupRoleExists(
  organizationId,
  groupId,
  roleId
) {
  return exists(
    groupRolePath(
      organizationId,
      groupId,
      roleId
    )
  );
}

function activeGroupRoleExists(
  organizationId,
  groupId,
  roleId
) {
  return groupRoleExists(
    organizationId,
    groupId,
    roleId
  )
  && get(
    groupRolePath(
      organizationId,
      groupId,
      roleId
    )
  ).data.active == true;
}

function groupRoleBelongsToGroup(
  organizationId,
  groupId,
  roleId
) {
  return groupRoleExists(
    organizationId,
    groupId,
    roleId
  )
  && get(
    groupRolePath(
      organizationId,
      groupId,
      roleId
    )
  ).data.groupId == groupId;
}

function groupRolePermissionPath(
  organizationId,
  groupId,
  roleId,
  permissionId
) {
  return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/roles/$(roleId)/permissions/$(permissionId);
}

function groupRolePermissionExists(
  organizationId,
  groupId,
  roleId,
  permissionId
) {
  return exists(
    groupRolePermissionPath(
      organizationId,
      groupId,
      roleId,
      permissionId
    )
  );
}

function activeGroupRolePermissionExists(
  organizationId,
  groupId,
  roleId,
  permissionId
) {
  return groupRolePermissionExists(
    organizationId,
    groupId,
    roleId,
    permissionId
  )
  && get(
    groupRolePermissionPath(
      organizationId,
      groupId,
      roleId,
      permissionId
    )
  ).data.active == true;
}

function groupRoleAssignmentPath(
  organizationId,
  groupId,
  assignmentId
) {
  return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/roleAssignments/$(assignmentId);
}

function groupRoleAssignmentExists(
  organizationId,
  groupId,
  assignmentId
) {
  return exists(
    groupRoleAssignmentPath(
      organizationId,
      groupId,
      assignmentId
    )
  );
}

function activeGroupRoleAssignmentExists(
  organizationId,
  groupId,
  assignmentId
) {
  return groupRoleAssignmentExists(
    organizationId,
    groupId,
    assignmentId
  )
  && get(
    groupRoleAssignmentPath(
      organizationId,
      groupId,
      assignmentId
    )
  ).data.active == true;
}

function groupAssignmentReferencesSameGroup(
  organizationId,
  groupId,
  groupMembershipId,
  groupRoleId
) {
  return activeGroupMembershipExists(
    organizationId,
    groupId,
    groupMembershipId
  )
  && activeGroupRoleExists(
    organizationId,
    groupId,
    groupRoleId
  )
  && get(
    groupMembershipPath(
      organizationId,
      groupId,
      groupMembershipId
    )
  ).data.groupId == groupId
  && get(
    groupRolePath(
      organizationId,
      groupId,
      groupRoleId
    )
  ).data.groupId == groupId;
}

// ============================================================
// ORGANIZATION APPLICATIONS
// ============================================================

/*
 * Organization application records represent the activation and
 * provisioning state of an application for a specific tenant.
 *
 * Path:
 *
 *   organizations/{organizationId}/applications/{applicationId}
 *
 * Application definitions themselves are platform metadata and are
 * NOT stored here. These records only represent the organization's
 * relationship with an application.
 *
 * Security principles:
 *
 *   1. Platform administrators have unrestricted access.
 *   2. Organization members can read only ACTIVE applications.
 *   3. Organization administrators can manage application records.
 *   4. Ordinary members cannot activate applications.
 *   5. An application cannot be moved between organizations.
 *   6. The applicationId is immutable.
 *
 * Provisioning should normally be performed by trusted platform
 * logic after an application has been approved/selected.
 */

match /organizations/{organizationId}/applications/{applicationId} {

  /*
   * Read a single application.
   *
   * Platform administrators can read any application.
   *
   * Organization administrators can inspect application lifecycle
   * states such as selected, provisioning, failed, suspended, etc.
   *
   * Ordinary organization members can only see applications that
   * are currently active.
   */
  allow get: if isPlatformAdmin()
    || isOrganizationAdmin(organizationId)
    || (
      isOrganizationMember(organizationId)
      && resource.data.status == "active"
    );

  /*
   * Application queries.
   *
   * Organization members are expected to query only active
   * applications for their organization.
   *
   * Organization administrators may query the complete application
   * collection for lifecycle and provisioning management.
   */
  allow list: if isPlatformAdmin()
    || isOrganizationAdmin(organizationId)
    || (
      isOrganizationMember(organizationId)
      && resource.data.status == "active"
    );

  /*
   * Application records may be created by:
   *
   *   - platform administrators
   *   - organization administrators
   *
   * Organization administrators cannot directly create an ACTIVE
   * application. Activation must occur through the controlled
   * provisioning/activation workflow.
   *
   * This prevents an organization user from simply writing:
   *
   *   status: "active"
   */
  allow create: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && request.resource.data.organizationId == organizationId
      && request.resource.data.applicationId == applicationId
      && request.resource.data.status in [
        "available",
        "selected"
      ]
    );

  /*
   * Updates must remain inside the same organization and must
   * continue to represent the same application.
   *
   * Organization administrators can manage the application
   * lifecycle but cannot directly transition an application to
   * ACTIVE.
   *
   * Platform administrators can perform the complete lifecycle,
   * including activation, suspension, deactivation, and recovery
   * from provisioning failures.
   */
  allow update: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && resource.data.organizationId == organizationId
      && request.resource.data.organizationId == organizationId
      && request.resource.data.applicationId == applicationId
      && request.resource.data.applicationId
        == resource.data.applicationId
      && request.resource.data.status != "active"
    );

  /*
   * Application records may be deleted by platform administrators
   * or organization administrators.
   *
   * Deactivation should normally be preferred over deletion so
   * that application lifecycle history can be preserved.
   */
  allow delete: if isPlatformAdmin()
    || isOrganizationAdmin(organizationId);
}


// ============================================================
// KNOWLEDGE HELPERS
// ============================================================

/*
 * Validate the structure of a Knowledge Article.
 *
 * Knowledge articles are platform-managed content.
 * The source content remains in Firestore; generated PDFs
 * are derived artifacts.
 */
function isValidKnowledgeArticle() {
  return request.resource.data.keys().hasAll([
    'id',
    'applicationKey',
    'title',
    'content',
    'contentType',
    'category',
    'tags',
    'audience',
    'status',
    'version',
    'authorId',
    'createdAt',
    'updatedAt',
    'downloadable'
  ])
  && request.resource.data.id is string
  && request.resource.data.applicationKey is string
  && request.resource.data.title is string
  && request.resource.data.content is string
  && request.resource.data.contentType is string
  && request.resource.data.category is string
  && request.resource.data.tags is list
  && request.resource.data.audience is list
  && request.resource.data.status in [
    'draft',
    'published',
    'archived'
  ]
  && request.resource.data.version is int
  && request.resource.data.authorId is string
  && request.resource.data.createdAt is string
  && request.resource.data.updatedAt is string
  && request.resource.data.downloadable is bool;
}

/*
 * Validate the structure of a Knowledge Article version.
 *
 * Versions are historical records and are immutable after
 * creation.
 */
function isValidKnowledgeArticleVersion() {
  return request.resource.data.keys().hasAll([
    'id',
    'articleId',
    'version',
    'title',
    'content',
    'contentType',
    'category',
    'tags',
    'audience',
    'createdBy',
    'createdAt'
  ])
  && request.resource.data.id is string
  && request.resource.data.articleId is string
  && request.resource.data.version is int
  && request.resource.data.title is string
  && request.resource.data.content is string
  && request.resource.data.contentType is string
  && request.resource.data.category is string
  && request.resource.data.tags is list
  && request.resource.data.audience is list
  && request.resource.data.createdBy is string
  && request.resource.data.createdAt is string;
}


// ============================================================
// USERS
// ============================================================

match /users/{userId} {

  /*
   * Users may read their own profile.
   *
   * Platform admins may read all user profiles.
   */
  allow get: if isCurrentUser(userId)
    || isPlatformAdmin();

  /*
   * User listing is intentionally restricted to platform admins.
   */
  allow list: if isPlatformAdmin();

  /*
   * A user may create their own initial profile.
   *
   * Platform admins can create user records.
   */
  allow create: if isCurrentUser(userId)
    || isPlatformAdmin();

  /*
   * Users can update their own profile, but cannot elevate
   * their platform role through the client.
   */
  allow update: if
    isPlatformAdmin()
    || (
      isCurrentUser(userId)
      && request.resource.data.role == resource.data.role
      && (
        (
          !resource.data.keys().hasAny(["platformRole"])
          && !request.resource.data.keys().hasAny(["platformRole"])
        )
        ||
        (
          resource.data.keys().hasAny(["platformRole"])
          && request.resource.data.keys().hasAny(["platformRole"])
          && request.resource.data.platformRole
            == resource.data.platformRole
        )
      )
    );

  allow delete: if isPlatformAdmin();
}


// ============================================================
// ORGANIZATION MEMBERSHIPS
// ============================================================

match /organizationMemberships/{membershipId} {

  /*
   * Members can read their own membership.
   *
   * Organization administrators can read memberships belonging
   * to their organization.
   *
   * Platform admins can read everything.
   */
  allow get: if isPlatformAdmin()
    || (
      isAuthenticated()
      && resource.data.userId == request.auth.uid
    )
    || isOrganizationAdmin(
      resource.data.organizationId
    );

  /*
   * Queries are authorized based on the documents that could
   * be returned.
   *
   * Supported query patterns:
   *
   *   where("userId", "==", currentUserId)
   *
   *   where("organizationId", "==", organizationId)
   *
   * Platform admins may query all memberships.
   */
  allow list: if isPlatformAdmin()
    || (
      isAuthenticated()
      && resource.data.keys().hasAll(["userId"])
      && resource.data.userId == request.auth.uid
    )
    || (
      isAuthenticated()
      && resource.data.keys().hasAll(["organizationId"])
      && isOrganizationAdmin(
        resource.data.organizationId
      )
    );

  /*
   * Membership creation is administrative.
   */
  allow create: if isPlatformAdmin()
    || (
      request.resource.data.organizationId != null
      && isOrganizationAdmin(
        request.resource.data.organizationId
      )
    );

  /*
   * Organization/user/role boundaries cannot be changed
   * during a normal client update.
   */
  allow update: if isPlatformAdmin()
    || (
      isOrganizationAdmin(
        resource.data.organizationId
      )
      && request.resource.data.userId
        == resource.data.userId
      && request.resource.data.organizationId
        == resource.data.organizationId
      && request.resource.data.role in [
        "org_owner",
        "org_admin",
        "org_manager",
        "org_staff",
        "org_member"
      ]
      && (
        request.auth.uid != resource.data.userId
        || request.resource.data.role == resource.data.role
      )
    );

  allow delete: if isPlatformAdmin()
    || (
      isOrganizationAdmin(
        resource.data.organizationId
      )
      && (
        request.auth.uid != resource.data.userId
        || resource.data.role != "org_owner"
      )
    );
}


// ============================================================
// ORGANIZATION GROUPS
// ============================================================

/*
 * Groups are tenant-scoped. There are intentionally no top-level
 * /groups, /groupMemberships, /groupRoles, /groupRoleAssignments,
 * or /groupRolePermissions collections.
 */

match /organizations/{organizationId}/groups/{groupId} {

  allow get: if isPlatformAdmin()
    || isOrganizationAdmin(organizationId)
    || (
      isOrganizationMember(organizationId)
      && resource.data.active == true
    );

  allow list: if isPlatformAdmin()
    || isOrganizationAdmin(organizationId)
    || (
      isOrganizationMember(organizationId)
      && resource.data.active == true
    );

  allow create: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && request.resource.data.systemManaged == false
      && request.resource.data.name is string
      && request.resource.data.slug is string
    );

  allow update: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && resource.data.systemManaged == false
      && request.resource.data.systemManaged == false
    );

  allow delete: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && resource.data.systemManaged == false
    );
}


// ============================================================
// GROUP MEMBERSHIPS
// ============================================================

match /organizations/{organizationId}/groups/{groupId}/members/{membershipId} {

  /*
   * Platform administrators can inspect all memberships.
   *
   * Organization administrators can inspect memberships for
   * active groups in their organization.
   *
   * A user can inspect their own active group membership.
   */
  allow get: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
    )
    || (
      isOwnGroupMembership(
        organizationId,
        groupId,
        membershipId
      )
      && isActiveGroup(
        organizationId,
        groupId
      )
    );

  /*
   * The user's group-membership query must be constrained by
   * userId. Organization administrators may query a group's
   * memberships.
   */
  allow list: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
    )
    || (
      isOrganizationMember(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && resource.data.userId == request.auth.uid
      && resource.data.active == true
    );

  /*
   * Only organization administrators can add group members.
   *
   * The membership document must belong to the Group represented
   * by the URL.
   */
  allow create: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && request.resource.data.groupId == groupId
      && request.resource.data.userId is string
      && request.resource.data.userId != ""
      && request.resource.data.active == true
    );

  /*
   * Membership identity and group ownership are immutable.
   */
  allow update: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && resource.data.groupId == groupId
      && request.resource.data.groupId == groupId
      && resource.data.userId == request.resource.data.userId
    );

  allow delete: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
    );
}


// ============================================================
// GROUP ROLES
// ============================================================

match /organizations/{organizationId}/groups/{groupId}/roles/{roleId} {

  /*
   * Organization administrators manage Group ACL configuration.
   *
   * Active organization members may read active roles because
   * role configuration is consumed by authorization evaluation.
   */
  allow get: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
    )
    || (
      isOrganizationMember(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && resource.data.active == true
    );

  allow list: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
    )
    || (
      isOrganizationMember(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && resource.data.active == true
    );

  /*
   * Organization administrators may create only ordinary roles.
   * System-managed roles are platform-controlled.
   */
  allow create: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && request.resource.data.groupId == groupId
      && request.resource.data.systemManaged == false
      && request.resource.data.name is string
      && request.resource.data.name != ""
    );

  allow update: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && resource.data.groupId == groupId
      && request.resource.data.groupId == groupId
      && resource.data.systemManaged == false
      && request.resource.data.systemManaged == false
    );

  allow delete: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && resource.data.systemManaged == false
    );
}


// ============================================================
// GROUP ROLE PERMISSIONS
// ============================================================

match /organizations/{organizationId}/groups/{groupId}/roles/{roleId}/permissions/{permissionId} {

  /*
   * Permission records are scoped to the role in the URL.
   *
   * Active organization members may read active permissions
   * needed for authorization evaluation.
   */
  allow get: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && activeGroupRoleExists(
        organizationId,
        groupId,
        roleId
      )
      && resource.data.groupRoleId == roleId
      && resource.data.active == true
    )
    || (
      isOrganizationMember(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && activeGroupRoleExists(
        organizationId,
        groupId,
        roleId
      )
      && resource.data.groupRoleId == roleId
      && resource.data.active == true
    );

  /*
   * Organization administrators may query the full permission
   * configuration. Members may query active permissions.
   */
  allow list: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && activeGroupRoleExists(
        organizationId,
        groupId,
        roleId
      )
      && resource.data.groupRoleId == roleId
    )
    || (
      isOrganizationMember(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && activeGroupRoleExists(
        organizationId,
        groupId,
        roleId
      )
      && resource.data.groupRoleId == roleId
      && resource.data.active == true
    );

  /*
   * Permission values are stable permission keys. The permission
   * document cannot be attached to a different GroupRole.
   */
  allow create: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && groupRoleBelongsToGroup(
        organizationId,
        groupId,
        roleId
      )
      && request.resource.data.groupRoleId == roleId
      && request.resource.data.permission is string
      && request.resource.data.permission != ""
      && request.resource.data.active == true
    );

  /*
   * The GroupRole reference and permission key are immutable.
   * Administrators may change lifecycle state.
   */
  allow update: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && groupRoleBelongsToGroup(
        organizationId,
        groupId,
        roleId
      )
      && resource.data.groupRoleId == roleId
      && request.resource.data.groupRoleId == roleId
      && request.resource.data.permission == resource.data.permission
    );

  allow delete: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && groupRoleBelongsToGroup(
        organizationId,
        groupId,
        roleId
      )
    );
}


// ============================================================
// GROUP ROLE ASSIGNMENTS
// ============================================================

match /organizations/{organizationId}/groups/{groupId}/roleAssignments/{assignmentId} {

  /*
   * Assignment references must point to an active membership and
   * active role belonging to this exact Group.
   */
  allow get: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && groupAssignmentReferencesSameGroup(
        organizationId,
        groupId,
        resource.data.groupMembershipId,
        resource.data.groupRoleId
      )
    )
    || (
      isOrganizationMember(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && isOwnGroupMembership(
        organizationId,
        groupId,
        resource.data.groupMembershipId
      )
      && activeGroupRoleExists(
        organizationId,
        groupId,
        resource.data.groupRoleId
      )
    );

  /*
   * Organization administrators may query assignments for a Group.
   *
   * Normal members may query only assignments belonging to their
   * own active Group membership.
   */
  allow list: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
    )
    || (
      isOrganizationMember(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && resource.data.groupMembershipId is string
      && isOwnGroupMembership(
        organizationId,
        groupId,
        resource.data.groupMembershipId
      )
      && resource.data.active == true
    );

  /*
   * Only organization administrators may assign Group roles.
   *
   * Both references must belong to the same Group and both must
   * be active.
   */
  allow create: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && groupAssignmentReferencesSameGroup(
        organizationId,
        groupId,
        request.resource.data.groupMembershipId,
        request.resource.data.groupRoleId
      )
      && request.resource.data.active == true
    );

  /*
   * Assignment references are immutable. Lifecycle state may change.
   */
  allow update: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
      && activeGroupMembershipExists(
        organizationId,
        groupId,
        resource.data.groupMembershipId
      )
      && activeGroupRoleExists(
        organizationId,
        groupId,
        resource.data.groupRoleId
      )
      && request.resource.data.groupMembershipId
        == resource.data.groupMembershipId
      && request.resource.data.groupRoleId
        == resource.data.groupRoleId
    );

  allow delete: if isPlatformAdmin()
    || (
      isOrganizationAdmin(organizationId)
      && isActiveGroup(
        organizationId,
        groupId
      )
    );
}


// ============================================================
// END ORGANIZATION GROUP SECURITY
// ============================================================

// ============================================================
// TEST CENTER HELPERS
// ============================================================

/*
 * Test Center is organization-scoped.
 *
 * Organization membership is the tenant boundary:
 *   - active members may read permitted Test Center content
 *   - organization owners/admins may manage Test Center content
 *   - platform admins retain platform-wide access
 *
 * The organizationId on Test Center documents is immutable after
 * creation so a document cannot be moved between organizations.
 */
function isTestCenterMember(organizationId) {
  return isPlatformAdmin()
    || isOrganizationMember(organizationId);
}

function isTestCenterAdmin(organizationId) {
  return isPlatformAdmin()
    || isOrganizationManagerOrAbove(organizationId);
}

function canCreateTestCenterDocument(organizationId) {
  return isTestCenterAdmin(organizationId);
}

// ============================================================
// TEST PROGRAM HELPERS
// ============================================================

/*
 * Test Programs are organization-scoped.
 *
 * Platform administrators have unrestricted access.
 *
 * Active organization members may read programs belonging
 * to their organization.
 *
 * Managers and above may create and update programs.
 *
 * Program ownership cannot cross organization boundaries.
 */
function testProgramBelongsToOrganization(
  programId,
  organizationId
) {
  return exists(
    /databases/$(database)/documents/testPrograms/$(programId)
  )
  && get(
    /databases/$(database)/documents/testPrograms/$(programId)
  ).data.organizationId == organizationId;
}

function testCourseProgramBelongsToOrganization(
  programId,
  organizationId
) {
  return programId is string
    && programId != ""
    && testProgramBelongsToOrganization(
      programId,
      organizationId
    );
}

function canCreateTestProgram(
  organizationId
) {
  return isTestCenterAdmin(
    organizationId
  );
}

function canUpdateTestProgram(
  organizationId,
  programId
) {
  return isTestCenterAdmin(
    organizationId
  )
  && testProgramBelongsToOrganization(
    programId,
    organizationId
  );
}

function canDeleteTestProgram(
  organizationId,
  programId
) {
  return isTestCenterAdmin(
    organizationId
  )
  && testProgramBelongsToOrganization(
    programId,
    organizationId
  );
}


function testCenterCourseBelongsToOrganization(
  courseId,
  organizationId
) {
  return exists(
    /databases/$(database)/documents/testCourses/$(courseId)
  )
  && get(
    /databases/$(database)/documents/testCourses/$(courseId)
  ).data.organizationId == organizationId;
}

function testCenterTopicBelongsToOrganization(
  topicId,
  organizationId,
  courseId
) {
  return exists(
    /databases/$(database)/documents/testTopics/$(topicId)
  )
  && get(
    /databases/$(database)/documents/testTopics/$(topicId)
  ).data.organizationId == organizationId
  && get(
    /databases/$(database)/documents/testTopics/$(topicId)
  ).data.courseId == courseId;
}

function canCreateTestCenterTopic(
  organizationId,
  courseId
) {
  return isTestCenterAdmin(organizationId)
    && testCenterCourseBelongsToOrganization(
      courseId,
      organizationId
    );
}

function canCreateTestCenterQuestion(
  organizationId,
  courseId,
  topicId
) {
  return isTestCenterAdmin(organizationId)
    && testCenterCourseBelongsToOrganization(
      courseId,
      organizationId
    )
    && testCenterTopicBelongsToOrganization(
      topicId,
      organizationId,
      courseId
    );
}

function canCreateTestCenterAttempt(
  organizationId,
  courseId
) {
  return isOrganizationMember(organizationId)
    && testCenterCourseBelongsToOrganization(
      courseId,
      organizationId
    );
}

function canCreateTestCenterResult(
  organizationId,
  userId,
  courseId,
  attemptId
) {
  return isOrganizationMember(organizationId)
    && request.auth.uid == userId
    && testCenterCourseBelongsToOrganization(
      courseId,
      organizationId
    )
    && exists(
      /databases/$(database)/documents/testAttempts/$(attemptId)
    )
    && get(
      /databases/$(database)/documents/testAttempts/$(attemptId)
    ).data.organizationId == organizationId
    && get(
      /databases/$(database)/documents/testAttempts/$(attemptId)
    ).data.userId == userId;
}

// ============================================================
// KNOWLEDGE ARTICLES
// ============================================================

match /knowledgeArticles/{articleId} {

  /*
   * Authenticated users may read published Knowledge articles.
   *
   * Draft and archived articles remain administrative content.
   */
  allow get: if isAuthenticated()
    && resource.data.status == "published";

  /*
   * Platform administrators may read all article states.
   */
  allow get: if isPlatformAdmin();

  /*
   * User-facing queries may return published articles.
   *
   * Platform administrators may query all articles.
   */
  allow list: if isPlatformAdmin()
    || (
      isAuthenticated()
      && resource.data.status == "published"
    );

  /*
   * Only platform administrators can create Knowledge articles.
   */
  allow create: if isPlatformAdmin()
    && isValidKnowledgeArticle()
    && request.resource.data.id == articleId;

  /*
   * Only platform administrators can update Knowledge articles.
   *
   * The document ID remains immutable.
   */
  allow update: if isPlatformAdmin()
    && isValidKnowledgeArticle()
    && request.resource.data.id == resource.data.id
    && request.resource.data.id == articleId;

  /*
   * Only platform administrators can permanently delete
   * Knowledge articles.
   *
   * Published articles should normally be archived first.
   */
  allow delete: if isPlatformAdmin();
}


// ============================================================
// KNOWLEDGE ARTICLE VERSIONS
// ============================================================

match /knowledgeArticleVersions/{versionId} {

  /*
   * Version history is administrative information.
   */
  allow get: if isPlatformAdmin();

  allow list: if isPlatformAdmin();

  /*
   * Only platform administrators can create versions.
   */
  allow create: if isPlatformAdmin()
    && isValidKnowledgeArticleVersion()
    && request.resource.data.id == versionId;

  /*
   * Article versions are immutable.
   *
   * Once a version has been created, it cannot be changed.
   */
  allow update: if false;

  /*
   * Historical versions are protected from normal deletion.
   */
  allow delete: if false;
}

// ============================================================
// TEST PROGRAMS
// ============================================================

match /testPrograms/{programId} {

  /*
   * Test Programs are organization-scoped.
   *
   * Platform administrators have unrestricted access.
   *
   * Active organization members may read programs belonging
   * to their organization.
   *
   * Managers and above may create and update programs.
   */

  // ----------------------------------------------------------
  // READ
  // ----------------------------------------------------------

  allow get: if isPlatformAdmin()
    || (
      isAuthenticated()
      && isOrganizationMember(
        resource.data.organizationId
      )
    );

  allow list: if isPlatformAdmin()
    || (
      isAuthenticated()
      && isOrganizationMember(
        resource.data.organizationId
      )
    );

  // ----------------------------------------------------------
  // CREATE
  // ----------------------------------------------------------

  allow create: if isPlatformAdmin()
    || (
      isAuthenticated()
      && request.resource.data.organizationId is string
      && request.resource.data.organizationId != ""
      && isTestCenterAdmin(
        request.resource.data.organizationId
      )
      && request.resource.data.courseCount == 0
    );

  // ----------------------------------------------------------
  // UPDATE
  // ----------------------------------------------------------

  allow update: if isPlatformAdmin()
    || (
      isAuthenticated()
      && resource.data.organizationId is string
      && request.resource.data.organizationId
        == resource.data.organizationId
      && isTestCenterAdmin(
        resource.data.organizationId
      )
      && request.resource.data.courseCount
        == resource.data.courseCount
    );

  // ----------------------------------------------------------
  // DELETE
  // ----------------------------------------------------------

  /*
   * Disabled until Program/course reference protection
   * is implemented as part of the lifecycle.
   */
  allow delete: if false;
}



// ============================================================
// TEST CENTER COURSES
// ============================================================

match /testCourses/{courseId} {

  /*
   * Platform courses:
   *
   * Zebron-owned, public, active courses can be read
   * by authenticated users without organization membership.
   */
  allow get: if isPlatformAdmin()
    || (
      isAuthenticated()
      && resource.data.scope == 'platform'
      && resource.data.accessType == 'public'
      && resource.data.organizationId == null
      && resource.data.active == true
    )
    || (
      resource.data.scope == 'organization'
      && resource.data.accessType == 'organization-members'
      && resource.data.organizationId != null
      && isTestCenterMember(
        resource.data.organizationId
      )
      && resource.data.active == true
    );

  /*
   * Queries must be constrained by the client:
   *
   * Platform:
   *   scope == platform
   *   accessType == public
   *   active == true
   *
   * Organization:
   *   scope == organization
   *   organizationId == current organization
   *   accessType == organization-members
   *   active == true
   */
  allow list: if isPlatformAdmin()
    || (
      isAuthenticated()
      && (
        (
          resource.data.scope == 'platform'
          && resource.data.accessType == 'public'
          && resource.data.active == true
        )
        ||
        (
          resource.data.scope == 'organization'
          && resource.data.accessType == 'organization-members'
          && resource.data.organizationId != null
          && isOrganizationMember(resource.data.organizationId)
          && resource.data.active == true
        )
      )
    );
  /*
   * Organization administrators create organization courses.
   */
  allow create: if

  request.resource.data.scope == 'organization'
  && request.resource.data.accessType
    == 'organization-members'
  && request.resource.data.organizationId is string
  && request.resource.data.programId is string
  && request.resource.data.programId != ""
  && canCreateTestCenterDocument(
    request.resource.data.organizationId
  )
  && testCourseProgramBelongsToOrganization(
    request.resource.data.programId,
    request.resource.data.organizationId
  );

  /*
   * Platform courses are created/managed by platform admins.
   */
  allow create: if
    isPlatformAdmin()
    && request.resource.data.scope == 'platform'
    && request.resource.data.accessType == 'public'
    && request.resource.data.organizationId == null;

  /*
   * A course cannot be moved between organizations,
   * and organization courses cannot be converted into
   * platform courses by organization administrators.
   */
 allow update: if isPlatformAdmin()
  || (
    resource.data.scope == 'organization'
    && resource.data.organizationId is string
    && request.resource.data.scope == 'organization'
    && request.resource.data.organizationId
      == resource.data.organizationId
    && request.resource.data.accessType
      == 'organization-members'
    && request.resource.data.programId is string
    && request.resource.data.programId != ""
    && canCreateTestCenterDocument(
      resource.data.organizationId
    )
    && testCourseProgramBelongsToOrganization(
      request.resource.data.programId,
      resource.data.organizationId
    )
  );

  allow delete: if isPlatformAdmin()
    || (
      resource.data.scope == 'organization'
      && resource.data.organizationId is string
      && canCreateTestCenterDocument(
        resource.data.organizationId
      )
    );
}


// ============================================================
// TEST CENTER TOPICS
// ============================================================

match /testTopics/{topicId} {

  /*
   * Active topics are visible to members of the owning
   * organization. Platform administrators can inspect all.
   */
  allow get: if isPlatformAdmin()
    || (
      resource.data.organizationId != null
      && isTestCenterMember(resource.data.organizationId)
      && resource.data.active == true
    );

  allow list: if isPlatformAdmin()
    || (
      isAuthenticated()
      && resource.data.organizationId != null
      && isOrganizationMember(resource.data.organizationId)
      && resource.data.active == true
    );



  /*
   * Topic creation is restricted to organization administrators.
   */
   allow create: if
request.resource.data.organizationId is string
&& request.resource.data.courseId is string
&& canCreateTestCenterTopic(
  request.resource.data.organizationId,
  request.resource.data.courseId
);


  /*
   * Topics remain in their original organization and course.
   */
  allow update: if
isTestCenterAdmin(resource.data.organizationId)
&& request.resource.data.organizationId == resource.data.organizationId
&& request.resource.data.courseId == resource.data.courseId;

   allow delete: if
isTestCenterAdmin(resource.data.organizationId);
}


// ============================================================
// TEST CENTER QUESTIONS
// ============================================================

match /testQuestions/{questionId} {

  /*
   * Published questions are available to members of the
   * owning organization. Draft/archived questions are
   * administrative content.
   */
  allow get: if isPlatformAdmin()
    || (
      resource.data.organizationId != null
      && isTestCenterMember(resource.data.organizationId)
      && resource.data.status == "published"
    )
    || (
      resource.data.organizationId != null
      && isTestCenterAdmin(resource.data.organizationId)
    );

  /*
   * Normal test-taking queries must be scoped to an organization
   * and return published questions only. Organization admins may
   * query their complete question bank.
   */
  allow list: if isPlatformAdmin()
    || (
      isAuthenticated()
      && resource.data.organizationId != null
      && isOrganizationMember(resource.data.organizationId)
      && resource.data.status == "published"
    )
    || (
      isAuthenticated()
      && resource.data.organizationId != null
      && isOrganizationAdmin(resource.data.organizationId)
    );



  /*
   * Only organization administrators can create questions.
   * The organization is supplied by the trusted application
   * context and must be a string.
   */
 allow create: if
request.resource.data.organizationId is string
&& request.resource.data.courseId is string
&& request.resource.data.topicId is string
&& canCreateTestCenterQuestion(
  request.resource.data.organizationId,
  request.resource.data.courseId,
  request.resource.data.topicId
);

  /*
   * A question cannot be moved between organizations or courses
   * or topics through an update.
   */
  allow update: if
isTestCenterAdmin(resource.data.organizationId)
&& request.resource.data.organizationId == resource.data.organizationId
&& request.resource.data.courseId == resource.data.courseId
&& request.resource.data.topicId == resource.data.topicId;

  allow delete: if
isTestCenterAdmin(resource.data.organizationId);
}


// ============================================================
// TEST CENTER ATTEMPTS
// ============================================================

match /testAttempts/{attemptId} {

  /*
   * A user can read their own attempts. Organization admins can
   * inspect attempts belonging to their organization.
   */
  allow get: if isPlatformAdmin()
    || (
      resource.data.organizationId != null
      && isOrganizationMember(resource.data.organizationId)
      && resource.data.userId == request.auth.uid
    )
    || (
      resource.data.organizationId != null
      && isOrganizationAdmin(resource.data.organizationId)
    );

  /*
   * Queries must remain organization-scoped. A normal member
   * can only query their own attempts; organization admins can
   * query attempts for their organization.
   */
  allow list: if isPlatformAdmin()
    || (
      isAuthenticated()
      && resource.data.organizationId != null
      && isOrganizationMember(resource.data.organizationId)
      && resource.data.userId == request.auth.uid
    )
    || (
      isAuthenticated()
      && resource.data.organizationId != null
      && isOrganizationAdmin(resource.data.organizationId)
    );

  /*
   * Users create attempts for themselves. The organization must
   * be one in which they have an active membership.
   */
  allow create: if isAuthenticated()
    && request.resource.data.organizationId is string
    && isOrganizationMember(
      request.resource.data.organizationId
    )
    && request.resource.data.userId == request.auth.uid;

  /*
   * Attempts are historical records. Organization ownership and
   * user ownership cannot be changed.
   */
  allow update: if isPlatformAdmin()
    || (
      isOrganizationAdmin(resource.data.organizationId)
      && request.resource.data.organizationId
         == resource.data.organizationId
      && request.resource.data.userId
         == resource.data.userId
    );

  allow delete: if isPlatformAdmin()
    || (
      isOrganizationAdmin(resource.data.organizationId)
    );
}


// ============================================================
// TEST CENTER RESULTS
// ============================================================

match /testResults/{resultId} {

  /*
   * Users can read their own results. Organization admins can
   * inspect results belonging to their organization.
   */
  allow get: if isPlatformAdmin()
    || (
      resource.data.organizationId != null
      && isOrganizationMember(resource.data.organizationId)
      && resource.data.userId == request.auth.uid
    )
    || (
      resource.data.organizationId != null
      && isOrganizationAdmin(resource.data.organizationId)
    );

  allow list: if isPlatformAdmin()
    || (
      isAuthenticated()
      && resource.data.organizationId != null
      && isOrganizationMember(resource.data.organizationId)
      && resource.data.userId == request.auth.uid
    )
    || (
      isAuthenticated()
      && resource.data.organizationId != null
      && isOrganizationAdmin(resource.data.organizationId)
    );

  /*
   * Results are created by the user completing their own test.
   */
  allow create: if isAuthenticated()
    && request.resource.data.organizationId is string
    && isOrganizationMember(
      request.resource.data.organizationId
    )
    && request.resource.data.userId == request.auth.uid;

  /*
   * Result identity and tenant ownership are immutable.
   */
  allow update: if isPlatformAdmin()
    || (
      isOrganizationAdmin(resource.data.organizationId)
      && request.resource.data.organizationId
         == resource.data.organizationId
      && request.resource.data.userId
         == resource.data.userId
      && request.resource.data.attemptId
         == resource.data.attemptId
    );

  allow delete: if isPlatformAdmin()
    || (
      isOrganizationAdmin(resource.data.organizationId)
    );
}


// ============================================================
// DEFAULT DENY
// ============================================================

/*
 * There is intentionally NO:
 *
 * match /{document=**} {
 *   allow read, write: if true;
 * }
 *
 * Any collection without an explicit rule is denied.
 *
 * Feature-specific rules will be added for:
 *
 *   community
 *   chat
 *   resources
 *   jobs
 *   training
 *   test center
 *   notifications
 *   tax configuration
 *   incidents
 *   donations
 *   etc.
 */

}
}