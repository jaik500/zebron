rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // COMMON HELPERS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    /**
     * Determine whether the authenticated user is a
     * platform administrator.
     *
     * Canonical authorization:
     *
     *   platformRole == "platform-admin"
     *
     * Legacy compatibility:
     *
     *   role == "admin"
     *
     * is only honored when platformRole does not yet exist.
     */
    // ============================================================
    // ROLES ON THE SIGN-IN TOKEN (custom claims)
    // ============================================================

    /*
     * The syncClaims* Cloud Functions copy roles onto the sign-in token:
     *   zv   = 1                          claims are synced
     *   zpa  = true | false               platform administrator
     *   zorg = { organizationId: role }   active organization roles
     *
     * Checking the token costs no document reads. Platform admin status
     * is taken from the token whenever claims are synced; organization
     * roles found on the token are trusted, and anything missing from it
     * (new membership, too many organizations) falls back to reading the
     * membership document, so access is never wrongly denied.
     */
    function hasZebronClaims() {
      return isAuthenticated()
        && request.auth.token.get("zv", 0) == 1;
    }

    function claimedOrganizationRole(organizationId) {
      return hasZebronClaims()
        ? request.auth.token.get("zorg", {}).get(organizationId, "")
        : "";
    }

    function isPlatformAdmin() {
      return isAuthenticated()
        && (
          hasZebronClaims()
            ? request.auth.token.get("zpa", false) == true
            : isPlatformAdminFromProfile()
        );
    }

    function isPlatformAdminFromProfile() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && (
          (
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.keys().hasAny(["platformRole"])
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.get("platformRole", "") == "platform-admin"
          )
          ||
          (
            !get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.keys().hasAny(["platformRole"])
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.keys().hasAny(["role"])
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.get("role", "") == "admin"
          )
        );
    }

    function isOrganizationApplicationRequestOwner() {
      return isAuthenticated()
        && resource.data.keys().hasAny(["applicantUserId"])
        && resource.data.get("applicantUserId", "") == request.auth.uid;
    }

    function isOrganizationApplicationRequestOwnerForCreate() {
      return isAuthenticated()
        && request.resource.data.keys().hasAny(["applicantUserId"])
        && request.resource.data.get("applicantUserId", "") == request.auth.uid;
    }

    // ============================================================
    // ORGANIZATION MEMBERSHIP HELPERS
    // ============================================================

    /*
     * Organization memberships use deterministic IDs:
     *
     *   {userId}_{organizationId}
     *
     * Organization roles are namespaced separately from platform roles:
     *
     *   org_owner
     *   org_admin
     *   org_manager
     *   org_staff
     *   org_member
     */
    function organizationMembershipPath(
      userId,
      organizationId
    ) {
      return /databases/$(database)/documents/organizationMemberships/$(userId + "_" + organizationId);
    }

    function organizationMembershipExists(
      userId,
      organizationId
    ) {
      return exists(
        organizationMembershipPath(
          userId,
          organizationId
        )
      );
    }

    function isOrganizationMember(organizationId) {
      return isAuthenticated()
        && (
          claimedOrganizationRole(organizationId) != ""
          || isOrganizationMemberFromDocument(organizationId)
        );
    }

    function isOrganizationMemberFromDocument(organizationId) {
      return isAuthenticated()
        && organizationMembershipExists(
          request.auth.uid,
          organizationId
        )
        && get(
          organizationMembershipPath(
            request.auth.uid,
            organizationId
          )
        ).data.get("active", false) == true;
    }

    /**
     * Returns the lifecycle status of an organization.
     *
     * Legacy organizations without a status field remain compatible:
     * - active == true or missing: treated as active
     * - active == false: treated as suspended
     *
     * A missing organization is treated as restricted rather than active.
     */
    function organizationStatus(organizationId) {
      let organizationPath =
        /databases/$(database)/documents/organizations/$(organizationId);

      return exists(organizationPath)
        ? get(organizationPath).data.get(
            "status",
            get(organizationPath).data.get("active", true) == true
              ? "active"
              : "suspended"
          )
        : "missing";
    }

    /**
     * True when normal tenant operations are allowed.
     *
     * Onboarding remains separate from active operation so that
     * onboarding-specific permissions can be evaluated independently.
     */
    function isOrganizationOperational(organizationId) {
      return organizationStatus(organizationId) == "active";
    }

    /**
     * True when the organization can continue its onboarding workflow.
     */
    function isOrganizationOnboarding(organizationId) {
      return organizationStatus(organizationId) == "onboarding";
    }

    /** Organization configuration is allowed while active or onboarding. */
    function isOrganizationConfigurable(organizationId) {
      return isOrganizationOperational(organizationId)
        || isOrganizationOnboarding(organizationId);
    }

    /**
     * True when an organization is suspended or archived.
     */
    function isOrganizationRestricted(organizationId) {
      return organizationStatus(organizationId) in [
        "suspended",
        "archived"
      ];
    }

    function isOrganizationRole(
      organizationId,
      role
    ) {
      return claimedOrganizationRole(organizationId) == role
        || (
          isOrganizationMemberFromDocument(organizationId)
          && myOrganizationRoleFromDocument(organizationId) == role
        );
    }

    function myOrganizationRoleFromDocument(organizationId) {
      return get(
        organizationMembershipPath(
          request.auth.uid,
          organizationId
        )
      ).data.get("role", "");
    }

    function isOrganizationAdmin(organizationId) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || organizationRankOf(organizationId) >= 4
        );
    }

    function isOrganizationStaffOrAbove(
      organizationId
    ) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || organizationRankOf(organizationId) >= 2
        );
    }

    function isOrganizationManagerOrAbove(
      organizationId
    ) {
      return isAuthenticated()
        && (
          isPlatformAdmin()
          || organizationRankOf(organizationId) >= 3
        );
    }

    /*
     * The signed-in user's rank in an organization (0 when not an
     * active member): from the token when it has the role, otherwise
     * from the membership document.
     */
    function organizationRankOf(organizationId) {
      return claimedOrganizationRole(organizationId) != ""
        ? organizationRoleRank(claimedOrganizationRole(organizationId))
        : (
          isOrganizationMemberFromDocument(organizationId)
            ? organizationRoleRank(myOrganizationRoleFromDocument(organizationId))
            : 0
        );
    }

    /*
     * Organization role ladder:
     *   org_member (1) < org_staff (2) < org_manager (3)
     *   < org_admin (4) < org_owner (5)
     *
     * Unknown or missing roles rank 0.
     */
    function organizationRoleRank(role) {
      return {
        "org_member": 1,
        "org_staff": 2,
        "org_manager": 3,
        "org_admin": 4,
        "org_owner": 5
      }.get(role, 0);
    }

    /*
     * Rank of the signed-in user in an organization.
     *
     * Always call after isOrganizationMember(organizationId), which
     * guarantees the membership document exists and is active.
     */
    function myOrganizationRank(organizationId) {
      return organizationRankOf(organizationId);
    }

    /*
     * Managers, admins and owners can manage people whose role is
     * strictly below their own. Owners are never assigned by clients;
     * ownership transfer goes through Zebron (platform administrators).
     */
    function canManageOrganizationRole(organizationId, targetRole) {
      return isOrganizationMember(organizationId)
        && myOrganizationRank(organizationId) >= 3
        && organizationRoleRank(targetRole) >= 1
        && organizationRoleRank(targetRole)
          < myOrganizationRank(organizationId);
    }

    // ============================================================
    // ORGANIZATION APPLICATION REQUESTS
    // ============================================================

    /*
     * These records represent a request to create a new
     * Zebron organization.
     *
     * This is intentionally different from:
     *
     *   organizations/{organizationId}/applications/{applicationId}
     *
     * which represents application entitlements for an
     * already-existing organization.
     *
     * Lifecycle:
     *
     *   draft
     *      ↓
     *   submitted
     *      ↓
     *   under_review
     *      ├── rejected
     *      └── approved
     *              ↓
     *          provisioning
     *              ↓
     *           onboarding
     *              ↓
     *            active
     *
     * The applicant can never create the organization directly.
     * Organization creation remains platform-controlled.
     */
    match /organizationApplicationRequests/{requestId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------

      allow get: if isPlatformAdmin()
        || isOrganizationApplicationRequestOwner();

      allow list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.keys().hasAny(["applicantUserId"])
          && resource.data.get("applicantUserId", "") == request.auth.uid
        );

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if isOrganizationApplicationRequestOwnerForCreate()
        && request.resource.data.get("status", "") in [
          "draft",
          "submitted"
        ]
        && request.resource.data.get("organizationName", "") is string
        && request.resource.data.get("organizationName", "") != ""
        && request.resource.data.get("contactName", "") is string
        && request.resource.data.get("contactName", "") != ""
        && request.resource.data.get("contactEmail", "") is string
        && request.resource.data.get("contactEmail", "") != ""
        && request.resource.data.get("requestedApplications", []) is list;

      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if isPlatformAdmin()
        || (
          isOrganizationApplicationRequestOwner()
          && request.resource.data.get("applicantUserId", "")
            == resource.data.get("applicantUserId", "")
          && (
            (
              resource.data.get("status", "") == "draft"
              && request.resource.data.get("status", "") == "draft"
            )
            ||
            (
              resource.data.get("status", "") == "draft"
              && request.resource.data.get("status", "") == "submitted"
            )
          )
        );

      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isPlatformAdmin()
        || (
          isOrganizationApplicationRequestOwner()
          && resource.data.get("status", "") == "draft"
        );
    }

    // ============================================================
    // ORGANIZATIONS
    // ============================================================

    match /organizations/{organizationId} {

      // Platform administrators must retain access to manage
      // suspended and archived organizations.
      allow get: if isPlatformAdmin()
        || (
          isOrganizationMember(organizationId)
          && !isOrganizationRestricted(organizationId)
        );

      // Organization enumeration is reserved for platform admins.
      allow list: if isPlatformAdmin();

      // Organization creation remains a trusted administrative action.
      allow create: if isPlatformAdmin();

      // Lifecycle changes will be handled by trusted Cloud Functions.
      allow update: if isPlatformAdmin();

      // Do not allow browser clients to permanently delete organizations.
      // A separately designed deletion workflow will handle this later.
      allow delete: if false;
    }

    // ============================================================
    // ORGANIZATION APPLICATIONS
    // ============================================================

    match /organizations/{organizationId}/applications/{applicationId} {

      allow get: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId)
          && isOrganizationAdmin(organizationId)
        )
        || (
          isOrganizationOperational(organizationId)
          && isOrganizationMember(organizationId)
          && resource.data.status == "active"
        );

      allow list: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId)
          && isOrganizationAdmin(organizationId)
        )
        || (
          isOrganizationOperational(organizationId)
          && isOrganizationMember(organizationId)
          && resource.data.status == "active"
        );

      allow create: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId)
          && isOrganizationAdmin(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.applicationId == applicationId
          && request.resource.data.status in [
            "available",
            "selected"
          ]
        );

      allow update: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId)
          && isOrganizationAdmin(organizationId)
          && resource.data.organizationId == organizationId
          && request.resource.data.organizationId == organizationId
          && request.resource.data.applicationId == applicationId
          && request.resource.data.applicationId
            == resource.data.applicationId
          && request.resource.data.status != "active"

          // Prevent organization admins from changing fields
          // controlled by trusted provisioning operations.
          && !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny([
              "provisioningStrategy",
              "provisionedAt",
              "provisioningError",
              "activatedBy",
              "activatedAt"
            ])
        );

      allow delete: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId)
          && isOrganizationAdmin(organizationId)
        );
    }

    // ============================================================
    // ORGANIZATION ONBOARDING
    // ============================================================

    /*
     * Organization onboarding is created by the trusted provisioning
     * backend after a platform administrator approves an organization.
     *
     * The organization owner/admin can read and update onboarding
     * progress. Platform administrators retain full access.
     *
     * Clients cannot create or delete onboarding records.
     */
    match /organizationOnboarding/{organizationId} {

      /*
       * Platform administrators can inspect any onboarding record.
       *
       * Organization members can read the onboarding record for
       * organizations to which they actively belong.
       */
      allow get: if isPlatformAdmin()
        || isOrganizationMember(organizationId);

      /*
       * Organization onboarding is a single document, so list access
       * is intentionally disabled.
       */
      allow list: if false;

      /*
       * Provisioning is trusted backend work. The browser must not
       * create an onboarding record.
       */
      allow create: if false;

      /*
       * The organization owner or organization administrator may
       * update onboarding progress.
       */
      allow update: if isPlatformAdmin()
        || (
          isOrganizationAdmin(organizationId)
          && isOrganizationOnboarding(organizationId)
        );

      /*
       * Onboarding records are retained for audit/history.
       */
      allow delete: if false;
    }

    // ============================================================
    // ORGANIZATION INVITATIONS
    // ============================================================

    match /organizationInvitations/{invitationId} {

      /*
       * Platform administrators can inspect all invitations.
       *
       * Active members can read invitations belonging to their
       * organization.
       *
       * The invited user does not need direct Firestore access
       * before acceptance. The trusted callable handles acceptance.
       *
       * After acceptance, the user becomes an active organization
       * member and may read organization invitation records.
       */
      allow get: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.organizationId is string
          && isOrganizationConfigurable(
            resource.data.organizationId
          )
          && isOrganizationMember(
            resource.data.organizationId
          )
        );

      /*
       * Invitation queries are intentionally disabled.
       *
       * Invitation management uses trusted callable functions.
       */
      allow list: if false;

      /*
       * Invitation creation and lifecycle changes are exclusively
       * handled by trusted backend functions.
       */
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // ORGANIZATION MEMBERSHIPS
    // ============================================================

    match /organizationMemberships/{membershipId} {

      /*
       * Managers and above can read their organization's members,
       * so they can manage the roles below their own.
       */
      allow get: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.get("userId", "") == request.auth.uid
        )
        || (
          isOrganizationOperational(resource.data.get("organizationId", ""))
          && isOrganizationManagerOrAbove(resource.data.get("organizationId", ""))
        );

      allow list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.keys().hasAll(["userId"])
          && resource.data.get("userId", "") == request.auth.uid
        )
        || (
          isAuthenticated()
          && resource.data.keys().hasAll(["organizationId"])
          && isOrganizationOperational(resource.data.get("organizationId", ""))
          && isOrganizationManagerOrAbove(resource.data.get("organizationId", ""))
        );

      /*
       * New memberships can only carry a role below the creator's.
       */
      allow create: if isPlatformAdmin()
        || (
          request.resource.data.get("organizationId", "") != ""
          && isOrganizationOperational(request.resource.data.get("organizationId", ""))
          && request.resource.data.get("userId", "") != request.auth.uid
          && canManageOrganizationRole(
            request.resource.data.get("organizationId", ""),
            request.resource.data.get("role", "")
          )
        );

      allow update: if isPlatformAdmin()

        // Change role or status of someone below you, to a role
        // that is still below you. Never your own membership.
        || (
          isOrganizationOperational(resource.data.get("organizationId", ""))
          && request.auth.uid != resource.data.get("userId", "")
          && request.resource.data.get("userId", "")
            == resource.data.get("userId", "")
          && request.resource.data.get("organizationId", "")
            == resource.data.get("organizationId", "")
          && canManageOrganizationRole(
            resource.data.get("organizationId", ""),
            resource.data.get("role", "")
          )
          && canManageOrganizationRole(
            resource.data.get("organizationId", ""),
            request.resource.data.get("role", "")
          )
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "role",
              "active",
              "displayName",
              "email",
              "title",
              "phoneNumber",
              "updatedAt"
            ])
        )

        // Admins and owners may update their own directory details,
        // but never their own role or status.
        || (
          isOrganizationOperational(resource.data.get("organizationId", ""))
          && request.auth.uid == resource.data.get("userId", "")
          && isOrganizationAdmin(resource.data.get("organizationId", ""))
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "displayName",
              "email",
              "title",
              "phoneNumber",
              "updatedAt"
            ])
        );

      allow delete: if isPlatformAdmin()
        || (
          isOrganizationOperational(resource.data.get("organizationId", ""))
          && request.auth.uid != resource.data.get("userId", "")
          && canManageOrganizationRole(
            resource.data.get("organizationId", ""),
            resource.data.get("role", "")
          )
        );
    }

    // ============================================================
    // ORGANIZATION GROUP SECURITY HELPERS
    // ============================================================

    function groupPath(
      organizationId,
      groupId
    ) {
      return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId);
    }

    function groupExists(
      organizationId,
      groupId
    ) {
      return exists(
        groupPath(
          organizationId,
          groupId
        )
      );
    }

    function isActiveGroup(
      organizationId,
      groupId
    ) {
      return groupExists(
        organizationId,
        groupId
      )
      && get(
        groupPath(
          organizationId,
          groupId
        )
      ).data.get("active", false) == true;
    }

    function groupMembershipPath(
      organizationId,
      groupId,
      membershipId
    ) {
      return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/members/$(membershipId);
    }

    function groupMembershipExists(
      organizationId,
      groupId,
      membershipId
    ) {
      return exists(
        groupMembershipPath(
          organizationId,
          groupId,
          membershipId
        )
      );
    }

    function activeGroupMembershipExists(
      organizationId,
      groupId,
      membershipId
    ) {
      return groupMembershipExists(
        organizationId,
        groupId,
        membershipId
      )
      && get(
        groupMembershipPath(
          organizationId,
          groupId,
          membershipId
        )
      ).data.get("active", false) == true;
    }

    function isOwnGroupMembership(
      organizationId,
      groupId,
      membershipId
    ) {
      return isAuthenticated()
        && activeGroupMembershipExists(
          organizationId,
          groupId,
          membershipId
        )
        && get(
          groupMembershipPath(
            organizationId,
            groupId,
            membershipId
          )
        ).data.get("userId", "") == request.auth.uid;
    }

    function groupRolePath(
      organizationId,
      groupId,
      roleId
    ) {
      return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/roles/$(roleId);
    }

    function groupRoleExists(
      organizationId,
      groupId,
      roleId
    ) {
      return exists(
        groupRolePath(
          organizationId,
          groupId,
          roleId
        )
      );
    }

    function activeGroupRoleExists(
      organizationId,
      groupId,
      roleId
    ) {
      return groupRoleExists(
        organizationId,
        groupId,
        roleId
      )
      && get(
        groupRolePath(
          organizationId,
          groupId,
          roleId
        )
      ).data.get("active", false) == true;
    }

    function groupRoleBelongsToGroup(
      organizationId,
      groupId,
      roleId
    ) {
      return groupRoleExists(
        organizationId,
        groupId,
        roleId
      )
      && get(
        groupRolePath(
          organizationId,
          groupId,
          roleId
        )
      ).data.get("groupId", "") == groupId;
    }

    function groupRolePermissionPath(
      organizationId,
      groupId,
      roleId,
      permissionId
    ) {
      return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/roles/$(roleId)/permissions/$(permissionId);
    }

    function groupRolePermissionExists(
      organizationId,
      groupId,
      roleId,
      permissionId
    ) {
      return exists(
        groupRolePermissionPath(
          organizationId,
          groupId,
          roleId,
          permissionId
        )
      );
    }

    function activeGroupRolePermissionExists(
      organizationId,
      groupId,
      roleId,
      permissionId
    ) {
      return groupRolePermissionExists(
        organizationId,
        groupId,
        roleId,
        permissionId
      )
      && get(
        groupRolePermissionPath(
          organizationId,
          groupId,
          roleId,
          permissionId
        )
      ).data.get("active", false) == true;
    }

    function groupRoleAssignmentPath(
      organizationId,
      groupId,
      assignmentId
    ) {
      return /databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/roleAssignments/$(assignmentId);
    }

    function groupRoleAssignmentExists(
      organizationId,
      groupId,
      assignmentId
    ) {
      return exists(
        groupRoleAssignmentPath(
          organizationId,
          groupId,
          assignmentId
        )
      );
    }

    function activeGroupRoleAssignmentExists(
      organizationId,
      groupId,
      assignmentId
    ) {
      return groupRoleAssignmentExists(
        organizationId,
        groupId,
        assignmentId
      )
      && get(
        groupRoleAssignmentPath(
          organizationId,
          groupId,
          assignmentId
        )
      ).data.get("active", false) == true;
    }

    function groupAssignmentReferencesSameGroup(
      organizationId,
      groupId,
      groupMembershipId,
      groupRoleId
    ) {
      return activeGroupMembershipExists(
        organizationId,
        groupId,
        groupMembershipId
      )
      && activeGroupRoleExists(
        organizationId,
        groupId,
        groupRoleId
      );
    }

    // ============================================================
    // ORGANIZATION GROUPS
    // ============================================================

    match /organizations/{organizationId}/groups/{groupId} {

      allow get: if isPlatformAdmin()
        || (isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId))
        || (
          (isOrganizationOperational(organizationId) && isOrganizationMember(organizationId))
          && resource.data.active == true
        );

      allow list: if isPlatformAdmin()
        || (isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId))
        || (
          (isOrganizationOperational(organizationId) && isOrganizationMember(organizationId))
          && resource.data.active == true
        );

      allow create: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && request.resource.data.systemManaged == false
          && request.resource.data.name is string
          && request.resource.data.slug is string
        );

      allow update: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && resource.data.systemManaged == false
          && request.resource.data.systemManaged == false
        );

      allow delete: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && resource.data.systemManaged == false
        );
    }

    // ============================================================
    // ORGANIZATION SETTINGS
    // ============================================================

    /**
     * Organization settings are tenant-scoped configuration.
     *
     * Platform administrators retain access regardless of lifecycle
     * status. Organization administrators can manage settings while
     * their organization is active or completing onboarding.
     *
     * Permanent deletion remains platform-admin-only.
     */
    match /organizationSettings/{organizationId} {

      function canManageOrganizationSettings() {
        return isPlatformAdmin()
          || (
            isOrganizationAdmin(organizationId)
            && isOrganizationConfigurable(organizationId)
          );
      }

      // Read settings.
      allow get: if canManageOrganizationSettings();

      // Settings are accessed by organization ID.
      allow list: if false;

      // Create settings.
      allow create: if canManageOrganizationSettings();

      // Update settings.
      allow update: if canManageOrganizationSettings();

      // Permanent deletion is restricted to platform administrators.
      allow delete: if isPlatformAdmin();
    }

    // ============================================================
    // PARTNER ORGANIZATION SETTINGS
    // ============================================================

    /*
     * Partner organization settings are stored at:
     *
     *   organizations/{organizationId}/settings/partner
     *
     * Only platform administrators and organization owners/admins
     * may read or manage these settings.
     */
    match /organizations/{organizationId}/settings/partner {

      function canManagePartnerSettings() {
        return isPlatformAdmin()
          || (
            isOrganizationConfigurable(organizationId)
            && isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          );
      }

      allow get: if canManagePartnerSettings();
      allow list: if false;
      allow create: if canManagePartnerSettings();
      allow update: if canManagePartnerSettings();
      allow delete: if isPlatformAdmin();
    }

    // ============================================================
    // GROUP MEMBERSHIPS
    // ============================================================

    match /organizations/{organizationId}/groups/{groupId}/members/{membershipId} {

      allow get: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
        )
        || (
          isOrganizationOperational(organizationId) && isOwnGroupMembership(
            organizationId,
            groupId,
            membershipId
          )
          && isActiveGroup(
            organizationId,
            groupId
          )
        );

      allow list: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
        )
        || (
          (isOrganizationOperational(organizationId) && isOrganizationMember(organizationId))
          && isActiveGroup(
            organizationId,
            groupId
          )
          && resource.data.get("userId", "") == request.auth.uid
          && resource.data.active == true
        );

      allow create: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && request.resource.data.groupId == groupId
          && request.resource.data.userId is string
          && request.resource.data.userId != ""
          && request.resource.data.active == true
        );

      allow update: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && resource.data.groupId == groupId
          && request.resource.data.groupId == groupId
          && resource.data.userId == request.resource.data.userId
        );

      allow delete: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
        );
    }

    // ============================================================
    // GROUP ROLES
    // ============================================================

    match /organizations/{organizationId}/groups/{groupId}/roles/{roleId} {

      allow get: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
        )
        || (
          (isOrganizationOperational(organizationId) && isOrganizationMember(organizationId))
          && isActiveGroup(
            organizationId,
            groupId
          )
          && resource.data.active == true
        );

      allow list: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
        )
        || (
          (isOrganizationOperational(organizationId) && isOrganizationMember(organizationId))
          && isActiveGroup(
            organizationId,
            groupId
          )
          && resource.data.active == true
        );

      allow create: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && request.resource.data.groupId == groupId
          && request.resource.data.systemManaged == false
          && request.resource.data.name is string
          && request.resource.data.name != ""
        );

      allow update: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && resource.data.groupId == groupId
          && request.resource.data.groupId == groupId
          && resource.data.systemManaged == false
          && request.resource.data.systemManaged == false
        );

      allow delete: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && resource.data.systemManaged == false
        );
    }

    // ============================================================
    // GROUP ROLE PERMISSIONS
    // ============================================================

    match /organizations/{organizationId}/groups/{groupId}/roles/{roleId}/permissions/{permissionId} {

      allow get: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && activeGroupRoleExists(
            organizationId,
            groupId,
            roleId
          )
          && resource.data.groupRoleId == roleId
          && resource.data.active == true
        )
        || (
          (isOrganizationOperational(organizationId) && isOrganizationMember(organizationId))
          && isActiveGroup(
            organizationId,
            groupId
          )
          && activeGroupRoleExists(
            organizationId,
            groupId,
            roleId
          )
          && resource.data.groupRoleId == roleId
          && resource.data.active == true
        );

      allow list: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && activeGroupRoleExists(
            organizationId,
            groupId,
            roleId
          )
          && resource.data.groupRoleId == roleId
        )
        || (
          (isOrganizationOperational(organizationId) && isOrganizationMember(organizationId))
          && isActiveGroup(
            organizationId,
            groupId
          )
          && activeGroupRoleExists(
            organizationId,
            groupId,
            roleId
          )
          && resource.data.groupRoleId == roleId
          && resource.data.active == true
        );

      allow create: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && groupRoleBelongsToGroup(
            organizationId,
            groupId,
            roleId
          )
          && request.resource.data.groupRoleId == roleId
          && request.resource.data.permission is string
          && request.resource.data.permission != ""
          && request.resource.data.active == true
        );

      allow update: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && groupRoleBelongsToGroup(
            organizationId,
            groupId,
            roleId
          )
          && resource.data.groupRoleId == roleId
          && request.resource.data.groupRoleId == roleId
          && request.resource.data.permission
            == resource.data.permission
        );

      allow delete: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && groupRoleBelongsToGroup(
            organizationId,
            groupId,
            roleId
          )
        );
    }

    // ============================================================
    // GROUP ROLE ASSIGNMENTS
    // ============================================================

    match /organizations/{organizationId}/groups/{groupId}/roleAssignments/{assignmentId} {

      allow get: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && groupAssignmentReferencesSameGroup(
            organizationId,
            groupId,
            resource.data.groupMembershipId,
            resource.data.groupRoleId
          )
        )
        || (
          (isOrganizationOperational(organizationId) && isOrganizationMember(organizationId))
          && isActiveGroup(
            organizationId,
            groupId
          )
          && isOrganizationOperational(organizationId) && isOwnGroupMembership(
            organizationId,
            groupId,
            resource.data.groupMembershipId
          )
          && activeGroupRoleExists(
            organizationId,
            groupId,
            resource.data.groupRoleId
          )
        );

      allow list: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
        )
        || (
          (isOrganizationOperational(organizationId) && isOrganizationMember(organizationId))
          && isActiveGroup(
            organizationId,
            groupId
          )
          && resource.data.groupMembershipId is string
          && isOrganizationOperational(organizationId) && isOwnGroupMembership(
            organizationId,
            groupId,
            resource.data.groupMembershipId
          )
          && resource.data.active == true
        );

      allow create: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && groupAssignmentReferencesSameGroup(
            organizationId,
            groupId,
            request.resource.data.groupMembershipId,
            request.resource.data.groupRoleId
          )
          && request.resource.data.active == true
        );

      allow update: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
          && activeGroupMembershipExists(
            organizationId,
            groupId,
            resource.data.groupMembershipId
          )
          && activeGroupRoleExists(
            organizationId,
            groupId,
            resource.data.groupRoleId
          )
          && request.resource.data.groupMembershipId
            == resource.data.groupMembershipId
          && request.resource.data.groupRoleId
            == resource.data.groupRoleId
        );

      allow delete: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId) && isOrganizationAdmin(organizationId)
          && isActiveGroup(
            organizationId,
            groupId
          )
        );
    }

    // ============================================================
    // KNOWLEDGE HELPERS
    // ============================================================

    function isValidKnowledgeArticle() {
      return request.resource.data.keys().hasAll([
        'id',
        'applicationKey',
        'title',
        'content',
        'contentType',
        'category',
        'tags',
        'audience',
        'status',
        'version',
        'authorId',
        'createdAt',
        'updatedAt',
        'downloadable'
      ])
      && request.resource.data.id is string
      && request.resource.data.applicationKey is string
      && request.resource.data.title is string
      && request.resource.data.content is string
      && request.resource.data.contentType is string
      && request.resource.data.category is string
      && request.resource.data.tags is list
      && request.resource.data.audience is list
      && request.resource.data.status in [
        'draft',
        'published',
        'archived'
      ]
      && request.resource.data.version is int
      && request.resource.data.authorId is string
      && request.resource.data.createdAt is string
      && request.resource.data.updatedAt is string
      && request.resource.data.downloadable is bool;
    }

    function isValidKnowledgeArticleVersion() {
      return request.resource.data.keys().hasAll([
        'id',
        'articleId',
        'version',
        'title',
        'content',
        'contentType',
        'category',
        'tags',
        'audience',
        'createdBy',
        'createdAt'
      ])
      && request.resource.data.id is string
      && request.resource.data.articleId is string
      && request.resource.data.version is int
      && request.resource.data.title is string
      && request.resource.data.content is string
      && request.resource.data.contentType is string
      && request.resource.data.category is string
      && request.resource.data.tags is list
      && request.resource.data.audience is list
      && request.resource.data.createdBy is string
      && request.resource.data.createdAt is string;
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow get: if isCurrentUser(userId)
        || isPlatformAdmin();

      allow list: if isPlatformAdmin();

      allow create: if isPlatformAdmin()
        || (
          isCurrentUser(userId)
          && request.resource.data.get("role", "user") != "admin"
          && request.resource.data.get("platformRole", "") != "platform-admin"
        );

      allow update: if
        isPlatformAdmin()
        || (
          isCurrentUser(userId)
          && request.resource.data.get("role", "")
            == resource.data.get("role", "")
          && (
            (
              !resource.data.keys().hasAny(["platformRole"])
              && !request.resource.data.keys().hasAny(["platformRole"])
            )
            ||
            (
              resource.data.keys().hasAny(["platformRole"])
              && request.resource.data.keys().hasAny(["platformRole"])
              && request.resource.data.platformRole
                == resource.data.platformRole
            )
          )
        );

      allow delete: if isPlatformAdmin();
    }

    // ============================================================
    // PUBLIC COMMUNITY PROFILES
    // ============================================================

    /**
     * Public-facing profile fields only. Private account fields and
     * authorization fields must remain in users/{userId}.
     */
    match /communityProfiles/{userId} {
      function validCommunityProfile(data) {
        return data.keys().hasOnly([
          "displayName",
          "firstName",
          "lastName",
          "preferredName",
          "countryOfOrigin",
          "currentCountry",
          "city",
          "state",
          "bio",
          "website",
          "photoUrl",
          "createdAt",
          "updatedAt"
        ])
        && data.get("displayName", "") is string
        && data.get("firstName", "") is string
        && data.get("lastName", "") is string
        && data.get("preferredName", "") is string
        && data.get("countryOfOrigin", "") is string
        && data.get("currentCountry", "") is string
        && data.get("city", "") is string
        && data.get("state", "") is string
        && data.get("bio", "") is string
        && data.get("website", "") is string
        && data.get("photoUrl", "") is string;
      }

      // Community profiles are visible to authenticated users only.
      allow get, list: if isAuthenticated();

      // A user may create only their own public profile, and only with
      // the approved public fields. Roles, email, and private fields are
      // intentionally not allowed in this collection.
      allow create: if isCurrentUser(userId)
        && validCommunityProfile(request.resource.data)
        && request.resource.data.keys().hasAll([
          "displayName",
          "createdAt",
          "updatedAt"
        ]);

      // Users may update only their own public profile. Keep the original
      // creation timestamp and reject all fields outside the allowlist.
      allow update: if isCurrentUser(userId)
        && validCommunityProfile(request.resource.data)
        && request.resource.data.get("createdAt", null)
          == resource.data.get("createdAt", null)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "displayName",
            "firstName",
            "lastName",
            "preferredName",
            "countryOfOrigin",
            "currentCountry",
            "city",
            "state",
            "bio",
            "website",
            "photoUrl",
            "updatedAt"
          ]);

      allow delete: if isPlatformAdmin();
    }

    // ============================================================
    // PLATFORM TEST CENTER HELPERS
    // ============================================================

    function isActivePublicPlatformCourse(courseId) {
      let coursePath =
        /databases/$(database)/documents/testCourses/$(courseId);

      return exists(coursePath)
        && get(coursePath).data.get("scope", "") == "platform"
        && get(coursePath).data.get("accessType", "") == "public"
        && get(coursePath).data.get("organizationId", null) == null
        && get(coursePath).data.get("active", false) == true;
    }

    function isActivePlatformTopic(topicId, courseId) {
      let topicPath =
        /databases/$(database)/documents/testTopics/$(topicId);

      return exists(topicPath)
        && get(topicPath).data.get("scope", "") == "platform"
        && get(topicPath).data.get("organizationId", null) == null
        && get(topicPath).data.get("courseId", "") == courseId
        && get(topicPath).data.get("active", false) == true
        && isActivePublicPlatformCourse(courseId);
    }

    function isPublishedPlatformQuestion(questionId) {
      let questionPath =
        /databases/$(database)/documents/testQuestions/$(questionId);

      return exists(questionPath)
        && get(questionPath).data.get("scope", "") == "platform"
        && get(questionPath).data.get("organizationId", null) == null
        && get(questionPath).data.get("status", "") == "published"
        && isActivePlatformTopic(
          get(questionPath).data.get("topicId", ""),
          get(questionPath).data.get("courseId", "")
        );
    }

    // ============================================================
    // TEST CENTER HELPERS
    // ============================================================

    /**
     * Test Center access requires:
     * - An operational organization.
     * - An active organization membership.
     * - An active Test Center application entitlement.
     *
     * Platform administrators retain access for support and recovery.
     */
    function hasActiveTestCenterEntitlement(organizationId) {
      let entitlementPath =
        /databases/$(database)/documents/organizations/$(organizationId)/applications/test-center;

      return exists(entitlementPath)
        && get(entitlementPath).data.get("status", "") == "active";
    }

    function isTestCenterMember(organizationId) {
      return isPlatformAdmin()
        || (
          isOrganizationOperational(organizationId)
          && isOrganizationMember(organizationId)
          && hasActiveTestCenterEntitlement(organizationId)
        );
    }

    /**
     * Test Center administration requires an operational organization,
     * an appropriate organization role, and an active entitlement.
     */
    function isTestCenterAdmin(organizationId) {
      return isPlatformAdmin()
        || (
          isOrganizationOperational(organizationId)
          && isOrganizationManagerOrAbove(organizationId)
          && hasActiveTestCenterEntitlement(organizationId)
        );
    }

    /** Preserve owner/admin-only access for attempt and result administration. */
    function isOperationalOrganizationAdmin(organizationId) {
      return isPlatformAdmin()
        || (
          isOrganizationOperational(organizationId)
          && isOrganizationAdmin(organizationId)
        );
    }

    /**
     * Test Center document creation follows the same authorization
     * requirements as Test Center administration.
     */
    function canCreateTestCenterDocument(organizationId) {
      return isTestCenterAdmin(organizationId);
    }

    // ============================================================
    // TEST PROGRAM HELPERS
    // ============================================================

    function testProgramBelongsToOrganization(
      programId,
      organizationId
    ) {
      return exists(
        /databases/$(database)/documents/testPrograms/$(programId)
      )
      && get(
        /databases/$(database)/documents/testPrograms/$(programId)
      ).data.organizationId == organizationId;
    }

    function testCourseProgramBelongsToOrganization(
      programId,
      organizationId
    ) {
      return programId is string
        && programId != ""
        && testProgramBelongsToOrganization(
          programId,
          organizationId
        );
    }

    function canCreateTestProgram(
      organizationId
    ) {
      return isTestCenterAdmin(
        organizationId
      );
    }

    function canUpdateTestProgram(
      organizationId,
      programId
    ) {
      return isTestCenterAdmin(
        organizationId
      )
      && testProgramBelongsToOrganization(
        programId,
        organizationId
      );
    }

    function canDeleteTestProgram(
      organizationId,
      programId
    ) {
      return isTestCenterAdmin(
        organizationId
      )
      && testProgramBelongsToOrganization(
        programId,
        organizationId
      );
    }

    function testCenterCourseBelongsToOrganization(
      courseId,
      organizationId
    ) {
      return exists(
        /databases/$(database)/documents/testCourses/$(courseId)
      )
      && get(
        /databases/$(database)/documents/testCourses/$(courseId)
      ).data.organizationId == organizationId;
    }

    /**
     * Verifies that a topic exists and belongs to the specified
     * organization and course.
     *
     * Uses get() instead of an explicit exists() call.
     */
    function testCenterTopicBelongsToOrganization(
      topicId,
      organizationId,
      courseId
    ) {
      let topicPath =
        /databases/$(database)/documents/testTopics/$(topicId);

      return topicId is string
        && topicId != ""
        && organizationId is string
        && organizationId != ""
        && courseId is string
        && courseId != ""
        && exists(topicPath)
        && get(topicPath).data.organizationId == organizationId
        && get(topicPath).data.courseId == courseId;
    }

    function canCreateTestCenterTopic(
      organizationId,
      courseId
    ) {
      return isTestCenterAdmin(organizationId)
        && testCenterCourseBelongsToOrganization(
          courseId,
          organizationId
        );
    }

    /**
     * Authorizes question creation by Test Center administrators
     * and active members of the owning organization.
     *
     * Organization members may create questions for review.
     * Administrative permissions for editing and deletion remain separate.
     */
    function canCreateTestCenterQuestion(
      organizationId,
      courseId,
      topicId
    ) {
      return isTestCenterMember(organizationId)
        && testCenterTopicBelongsToOrganization(
          topicId,
          organizationId,
          courseId
        );
    }

    function canCreateTestCenterAttempt(
      organizationId,
      courseId
    ) {
      return isTestCenterMember(organizationId)
        && testCenterCourseBelongsToOrganization(
          courseId,
          organizationId
        );
    }

    function canCreateTestCenterResult(
      organizationId,
      userId,
      courseId,
      attemptId
    ) {
      return isTestCenterMember(organizationId)
        && request.auth.uid == userId
        && testCenterCourseBelongsToOrganization(
          courseId,
          organizationId
        )
        && exists(
          /databases/$(database)/documents/testAttempts/$(attemptId)
        )
        && get(
          /databases/$(database)/documents/testAttempts/$(attemptId)
        ).data.organizationId == organizationId
        && get(
          /databases/$(database)/documents/testAttempts/$(attemptId)
        ).data.userId == userId;
    }

    // ============================================================
    // TEST ATTEMPT AND RESULT VALIDATION
    // ============================================================

    function canCreatePlatformTestAttempt() {
      return isAuthenticated()
        && request.resource.data.get("organizationId", "missing") == null
        && request.resource.data.get("userId", "") == request.auth.uid
        && request.resource.data.get("courseId", "") is string
        && isActivePublicPlatformCourse(
          request.resource.data.courseId
        );
    }

    function canCreatePlatformTestResult() {
      let attemptId = request.resource.data.get("attemptId", "");
      let courseId = request.resource.data.get("courseId", "");

      let attemptPath =
        /databases/$(database)/documents/testAttempts/$(attemptId);

      return isAuthenticated()
        && request.resource.data.get("organizationId", "missing") == null
        && request.resource.data.get("userId", "") == request.auth.uid
        && courseId is string
        && isActivePublicPlatformCourse(courseId)
        && attemptId is string
        && attemptId != ""
        && existsAfter(attemptPath)
        && getAfter(attemptPath).data.get("organizationId", "missing") == null
        && getAfter(attemptPath).data.get("userId", "") == request.auth.uid
        && getAfter(attemptPath).data.get("courseId", "") == courseId;
    }

    // ============================================================
    // ORGANIZATION-SCOPED KNOWLEDGE ARTICLES
    // ============================================================

    /*
     * Canonical tenant-scoped storage:
     * organizations/{organizationId}/knowledgeArticles/{articleId}
     *
     * Platform administrators can inspect articles and versions across
     * organizations, including while an organization is restricted.
     * Active organization members can read published articles only.
     * Organization staff and above can read drafts and archived
     * articles while the organization is operational/configurable.
     *
     * Writes are restricted to platform administrators and organization
     * staff, managers, admins and owners. Version documents are immutable after
     * creation to preserve the article audit history.
     */
    match /organizations/{organizationId}/knowledgeArticles/{articleId} {

      allow get, list: if isPlatformAdmin();

      allow get, list: if isAuthenticated()
        && isOrganizationOperational(organizationId)
        && isOrganizationMember(organizationId)
        && resource.data.get("status", "") == "published";

      allow get, list: if isOrganizationOperational(organizationId)
        && isOrganizationStaffOrAbove(organizationId);

      allow create: if (
          isPlatformAdmin()
          || (
            isOrganizationOperational(organizationId)
            && isOrganizationStaffOrAbove(organizationId)
          )
        )
        && isValidKnowledgeArticle()
        && request.resource.data.id == articleId;

      allow update: if (
          isPlatformAdmin()
          || (
            isOrganizationOperational(organizationId)
            && isOrganizationStaffOrAbove(organizationId)
          )
        )
        && isValidKnowledgeArticle()
        && request.resource.data.id == resource.data.id
        && request.resource.data.id == articleId;

      allow delete: if isPlatformAdmin()
        || (
          isOrganizationOperational(organizationId)
          && isOrganizationStaffOrAbove(organizationId)
        );
    }

    // ============================================================
    // ORGANIZATION-SCOPED KNOWLEDGE ARTICLE VERSIONS
    // ============================================================

    match /organizations/{organizationId}/knowledgeArticles/{articleId}/versions/{versionId} {

      allow get, list: if isPlatformAdmin();

      allow get, list: if isOrganizationOperational(organizationId)
        && isOrganizationStaffOrAbove(organizationId);

      allow create: if (
          isPlatformAdmin()
          || (
            isOrganizationOperational(organizationId)
            && isOrganizationStaffOrAbove(organizationId)
          )
        )
        && isValidKnowledgeArticleVersion()
        && request.resource.data.id == versionId
        && request.resource.data.articleId == articleId;

      // Article versions are immutable audit records.
      allow update, delete: if false;
    }

    // ============================================================
    // LEGACY GLOBAL KNOWLEDGE ARTICLES (BACKWARD COMPATIBILITY)
    // ============================================================

    match /knowledgeArticles/{articleId} {

      allow get: if isAuthenticated()
        && resource.data.status == "published";

      allow get: if isPlatformAdmin();

      allow list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.status == "published"
        );

      allow create: if isPlatformAdmin()
        && isValidKnowledgeArticle()
        && request.resource.data.id == articleId;

      allow update: if isPlatformAdmin()
        && isValidKnowledgeArticle()
        && request.resource.data.id == resource.data.id
        && request.resource.data.id == articleId;

      allow delete: if isPlatformAdmin();
    }

    // ============================================================
    // KNOWLEDGE ARTICLE VERSIONS
    // ============================================================

    match /knowledgeArticleVersions/{versionId} {

      allow get: if isPlatformAdmin();

      allow list: if isPlatformAdmin();

      allow create: if isPlatformAdmin()
        && isValidKnowledgeArticleVersion()
        && request.resource.data.id == versionId;

      allow update: if false;

      allow delete: if false;
    }

    // ============================================================
    // TEST PROGRAMS
    // ============================================================

    match /testPrograms/{programId} {

      allow get: if isPlatformAdmin()
        || (
          isAuthenticated()
          && isTestCenterMember(
            resource.data.organizationId
          )
        );

      allow list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && isTestCenterMember(
            resource.data.organizationId
          )
        );

      allow create: if isPlatformAdmin()
        || (
          isAuthenticated()
          && request.resource.data.organizationId is string
          && request.resource.data.organizationId != ""
          && isTestCenterAdmin(
            request.resource.data.organizationId
          )
          && request.resource.data.courseCount == 0
        );

      allow update: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.organizationId is string
          && request.resource.data.get("organizationId", "")
            == resource.data.get("organizationId", "")
          && isTestCenterAdmin(
            resource.data.organizationId
          )
          && request.resource.data.courseCount
            == resource.data.courseCount
        );

      /*
       * Disabled until Program/course reference protection
       * is implemented as part of the lifecycle.
       */
      allow delete: if false;
    }

    // ============================================================
    // TEST CENTER COURSES
    // ============================================================

    match /testCourses/{courseId} {

      allow get: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.scope == 'platform'
          && resource.data.accessType == 'public'
          && resource.data.organizationId == null
          && resource.data.active == true
        )
        || (
          resource.data.scope == 'organization'
          && resource.data.accessType == 'organization-members'
          && resource.data.organizationId != null
          && isTestCenterMember(
            resource.data.organizationId
          )
          && resource.data.active == true
        );

      allow list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && (
            (
              resource.data.scope == 'platform'
              && resource.data.accessType == 'public'
              && resource.data.active == true
            )
            ||
            (
              resource.data.scope == 'organization'
              && resource.data.accessType == 'organization-members'
              && resource.data.organizationId != null
              && isTestCenterMember(
                resource.data.organizationId
              )
              && resource.data.active == true
            )
          )
        );

      allow create: if
        request.resource.data.scope == 'organization'
        && request.resource.data.accessType
          == 'organization-members'
        && request.resource.data.organizationId is string
        && request.resource.data.programId is string
        && request.resource.data.programId != ""
        && canCreateTestCenterDocument(
          request.resource.data.organizationId
        )
        && testCourseProgramBelongsToOrganization(
          request.resource.data.programId,
          request.resource.data.organizationId
        );

      allow create: if
        isPlatformAdmin()
        && request.resource.data.scope == 'platform'
        && request.resource.data.accessType == 'public'
        && request.resource.data.organizationId == null;

      allow update: if isPlatformAdmin()
        || (
          resource.data.scope == 'organization'
          && resource.data.organizationId is string
          && request.resource.data.scope == 'organization'
          && request.resource.data.organizationId
            == resource.data.organizationId
          && request.resource.data.accessType
            == 'organization-members'
          && request.resource.data.programId is string
          && request.resource.data.programId != ""
          && canCreateTestCenterDocument(
            resource.data.organizationId
          )
          && testCourseProgramBelongsToOrganization(
            request.resource.data.programId,
            resource.data.organizationId
          )
        );

      allow delete: if isPlatformAdmin()
        || (
          resource.data.scope == 'organization'
          && resource.data.organizationId is string
          && canCreateTestCenterDocument(
            resource.data.organizationId
          )
        );
    }

    // ============================================================
    // TEST CENTER TOPICS
    // ============================================================

    /*
     * Read rules are written so that they can be proven from the query
     * itself. A list query is rejected unless its where() clauses
     * guarantee that every possible result passes the rule, so clients
     * must query with:
     *
     *   - platform topics:      scope == 'platform', organizationId == null,
     *                           courseId == X, active == true
     *   - organization topics:  organizationId == X, courseId == Y,
     *                           active == true
     *
     * Test Center managers and above (isTestCenterAdmin) may read all
     * topics for their organization, including inactive ones.
     */
    match /testTopics/{topicId} {

      allow get, list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.get("scope", "") == "platform"
          && resource.data.get("organizationId", null) == null
          && resource.data.get("active", false) == true
          && isActivePublicPlatformCourse(
            resource.data.get("courseId", "")
          )
        )
        || (
          resource.data.get("organizationId", null) != null
          && isTestCenterMember(resource.data.organizationId)
          && resource.data.get("active", false) == true
        )
        || (
          resource.data.get("organizationId", null) != null
          && isTestCenterAdmin(resource.data.organizationId)
        );

      allow create: if
        request.resource.data.organizationId is string
        && request.resource.data.courseId is string
        && canCreateTestCenterTopic(
          request.resource.data.organizationId,
          request.resource.data.courseId
        );

      allow update: if
        isTestCenterAdmin(resource.data.organizationId)
        && request.resource.data.organizationId
          == resource.data.organizationId
        && request.resource.data.courseId
          == resource.data.courseId;

      allow delete: if
        isTestCenterAdmin(resource.data.organizationId);
    }

    // ============================================================
    // TEST CENTER QUESTIONS
    // ============================================================

    /*
     * As with topics, list queries must constrain the fields these rules
     * check. Learners must query with status == 'published' (and, for
     * platform questions, scope == 'platform' and organizationId == null).
     * Test Center managers and above can read every question for their
     * organization.
     */
    match /testQuestions/{questionId} {

      allow get: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.get("scope", "") == "platform"
          && resource.data.get("organizationId", null) == null
          && isPublishedPlatformQuestion(questionId)
        )
        || (
          resource.data.get("organizationId", null) != null
          && isTestCenterMember(resource.data.organizationId)
          && resource.data.get("status", "") == "published"
        )
        || (
          resource.data.get("organizationId", null) != null
          && isTestCenterAdmin(resource.data.organizationId)
        );

      allow list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.get("scope", "") == "platform"
          && resource.data.get("organizationId", null) == null
          && resource.data.get("status", "") == "published"
          && isActivePublicPlatformCourse(
            resource.data.get("courseId", "")
          )
        )
        || (
          isAuthenticated()
          && resource.data.get("organizationId", null) != null
          && isTestCenterMember(resource.data.organizationId)
          && resource.data.get("status", "") == "published"
        )
        || (
          isAuthenticated()
          && resource.data.get("organizationId", null) != null
          && isTestCenterAdmin(resource.data.organizationId)
        );

      allow create: if
        request.resource.data.organizationId is string
        && request.resource.data.courseId is string
        && request.resource.data.topicId is string
        && canCreateTestCenterQuestion(
          request.resource.data.organizationId,
          request.resource.data.courseId,
          request.resource.data.topicId
        );

      allow update: if
        isTestCenterAdmin(resource.data.organizationId)
        && request.resource.data.organizationId
          == resource.data.organizationId
        && request.resource.data.courseId
          == resource.data.courseId
        && request.resource.data.topicId
          == resource.data.topicId;

      allow delete: if
        isTestCenterAdmin(resource.data.organizationId);
    }

    // ============================================================
    // TEST CENTER ATTEMPTS
    // ============================================================

    match /testAttempts/{attemptId} {

      allow get: if isPlatformAdmin()
        || (
          resource.data.organizationId != null
          && isTestCenterMember(resource.data.organizationId)
          && resource.data.get("userId", "") == request.auth.uid
        )
        || (
          resource.data.organizationId != null
          && isOperationalOrganizationAdmin(resource.data.organizationId)
        );

      allow list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.organizationId != null
          && isTestCenterMember(resource.data.organizationId)
          && resource.data.get("userId", "") == request.auth.uid
        )
        || (
          isAuthenticated()
          && resource.data.organizationId != null
          && isOperationalOrganizationAdmin(resource.data.organizationId)
        );

      allow create: if isAuthenticated()
        && (
          (
            request.resource.data.get("organizationId", null) is string
            && isTestCenterMember(
              request.resource.data.organizationId
            )
            && request.resource.data.get("userId", "") == request.auth.uid
          )
          || canCreatePlatformTestAttempt()
        );

      allow update: if isPlatformAdmin()
        || (
          isOperationalOrganizationAdmin(resource.data.organizationId)
          && request.resource.data.organizationId
            == resource.data.organizationId
          && request.resource.data.userId
            == resource.data.userId
        );

      allow delete: if isPlatformAdmin()
        || (
          isOperationalOrganizationAdmin(resource.data.organizationId)
        );
    }

    // ============================================================
    // TEST CENTER RESULTS
    // ============================================================

    match /testResults/{resultId} {

      allow get: if isPlatformAdmin()
        || (
          resource.data.organizationId != null
          && isTestCenterMember(resource.data.organizationId)
          && resource.data.get("userId", "") == request.auth.uid
        )
        || (
          resource.data.organizationId != null
          && isOperationalOrganizationAdmin(resource.data.organizationId)
        );

      allow list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.organizationId != null
          && isTestCenterMember(resource.data.organizationId)
          && resource.data.get("userId", "") == request.auth.uid
        )
        || (
          isAuthenticated()
          && resource.data.organizationId != null
          && isOperationalOrganizationAdmin(resource.data.organizationId)
        );

      allow create: if isAuthenticated()
        && (
          (
            request.resource.data.get("organizationId", null) is string
            && isTestCenterMember(
              request.resource.data.organizationId
            )
            && request.resource.data.get("userId", "") == request.auth.uid
          )
          || canCreatePlatformTestResult()
        );

      allow update: if isPlatformAdmin()
        || (
          isOperationalOrganizationAdmin(resource.data.organizationId)
          && request.resource.data.organizationId
            == resource.data.organizationId
          && request.resource.data.userId
            == resource.data.userId
          && request.resource.data.attemptId
            == resource.data.attemptId
        );

      allow delete: if isPlatformAdmin()
        || (
          isOperationalOrganizationAdmin(resource.data.organizationId)
        );
    }

    // ============================================================
    // ROLE CHANGE SIGNAL
    // ============================================================

    // Written by the claims functions; the app listens to refresh the
    // sign-in token when roles change.
    match /userClaims/{userId} {
      allow get: if isCurrentUser(userId);
      allow list, write: if false;
    }

    // ============================================================
    // COMMUNITY SCOPE
    // ============================================================

    /*
     * Community posts carry organizationId:
     *   null (or missing on older posts) -> public Zebron Community
     *   "<organizationId>"               -> that organization's private
     *                                       community
     *
     * Organization communities are visible to active members of an
     * active organization. Managers, admins and owners moderate their
     * organization's community; platform administrators moderate all.
     */
    function communityScopeOf(data) {
      return data.get("organizationId", null);
    }

    function canSeeCommunityScope(organizationId) {
      return organizationId == null
        || isPlatformAdmin()
        || (
          organizationId is string
          && isOrganizationOperational(organizationId)
          && isOrganizationMember(organizationId)
        );
    }

    function canModerateCommunityScope(organizationId) {
      return isPlatformAdmin()
        || (
          organizationId is string
          && isOrganizationOperational(organizationId)
          && isOrganizationManagerOrAbove(organizationId)
        );
    }

    function communityPostPath(postId) {
      return /databases/$(database)/documents/communityPosts/$(postId);
    }

    /* Published, approved and visible to the signed-in user. */
    function communityPostIsOpen(postId) {
      return exists(communityPostPath(postId))
        && get(communityPostPath(postId)).data.get("status", "") == "published"
        && get(communityPostPath(postId)).data.get("moderationStatus", "") == "approved"
        && canSeeCommunityScope(
          communityScopeOf(get(communityPostPath(postId)).data)
        );
    }

    // ============================================================
    // COMMUNITY POSTS
    // ============================================================

    match /communityPosts/{postId} {

      /*
       * Read strictly (no default). Firestore checks list queries against
       * their filters, and a default would let a query without an
       * organizationId filter pass as "public" and return private
       * organization posts. Every post has the field: new posts must
       * set it and backfillCommunityPostScope adds it to older posts.
       */
      function postScope() {
        return resource.data.organizationId;
      }

      function validPostText(data) {
        return data.title is string
          && data.title.size() > 0
          && data.title.size() <= 200
          && data.content is string
          && data.content.size() > 0
          && data.content.size() <= 10000
          && data.topicId is string
          && data.topicId.size() > 0
          && data.get("tags", []) is list
          && data.get("tags", []).size() <= 20
          && data.get("mediaUrls", []) is list
          && data.get("mediaUrls", []).size() <= 10;
      }

      /*
       * New posts are written by the browser (CommunityPostService).
       * Authors cannot pre-load engagement, ranking or moderation.
       * Organization posts require an active membership.
       */
      function isValidNewPost() {
        let data = request.resource.data;
        let organizationId = data.get("organizationId", null);

        return isAuthenticated()
          && data.keys().hasAll([
            "authorId",
            "author",
            "topicId",
            "title",
            "content",
            "status",
            "moderationStatus",
            "reactionCounts",
            "commentCount",
            "viewCount",
            "organizationId",
            "createdAt",
            "updatedAt"
          ])
          && data.keys().hasOnly([
            "authorId",
            "author",
            "topicId",
            "topicName",
            "title",
            "content",
            "mediaUrls",
            "tags",
            "status",
            "moderationStatus",
            "reactionCounts",
            "commentCount",
            "viewCount",
            "trendingScore",
            "organizationId",
            "createdAt",
            "updatedAt"
          ])
          && data.authorId == request.auth.uid
          && data.author is map
          && data.author.get("id", "") == request.auth.uid
          && validPostText(data)
          && data.status == "published"
          && data.moderationStatus == "approved"
          && data.reactionCounts is map
          && data.commentCount == 0
          && data.viewCount == 0
          && data.get("trendingScore", 0) == 0
          && data.createdAt == request.time
          && (
            organizationId == null
            || (
              organizationId is string
              && isOrganizationOperational(organizationId)
              && isOrganizationMember(organizationId)
            )
          );
      }

      /* Authors edit the text of their own published posts. */
      function isAuthorEditingPost() {
        return isAuthenticated()
          && resource.data.get("authorId", "") == request.auth.uid
          && resource.data.get("status", "") == "published"
          && canSeeCommunityScope(postScope())
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "title",
              "content",
              "tags",
              "topicId",
              "topicName",
              "mediaUrls",
              "editedAt",
              "updatedAt"
            ])
          && validPostText(request.resource.data);
      }

      /* Authors delete (soft) their own posts. */
      function isAuthorDeletingPost() {
        return isAuthenticated()
          && resource.data.get("authorId", "") == request.auth.uid
          && resource.data.get("status", "") in ["published", "hidden"]
          && request.resource.data.get("status", "") == "deleted"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "deletedAt", "updatedAt"]);
      }

      /*
       * Moderators hide, restore or remove posts. Organization
       * managers and above moderate their organization's posts;
       * platform administrators moderate everything.
       */
      function isModeratingPost() {
        return isAuthenticated()
          && canModerateCommunityScope(postScope())
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "status",
              "moderationStatus",
              "moderatedBy",
              "moderatedAt",
              "moderationReason",
              "updatedAt"
            ])
          && request.resource.data.get("status", "")
            in ["published", "hidden", "deleted"]
          && request.resource.data.get("moderationStatus", "")
            in ["approved", "flagged", "rejected", "pending"]
          && request.resource.data.get("moderatedBy", "") == request.auth.uid;
      }

      function isPublishedAndApprovedPost() {
        return resource.data.get("status", "") == "published"
          && resource.data.get("moderationStatus", "") == "approved";
      }

      function isValidReactionType(reactionType) {
        return reactionType in [
          "like",
          "love",
          "laugh",
          "celebrate",
          "support",
          "helpful"
        ];
      }

      function reactionCountsMatchTransition(
        countsBefore,
        countsAfter,
        typeBefore,
        typeAfter
      ) {
        return countsAfter.get("like", 0)
            == countsBefore.get("like", 0)
              + (typeAfter == "like" ? 1 : 0)
              - (typeBefore == "like" ? 1 : 0)
          && countsAfter.get("love", 0)
            == countsBefore.get("love", 0)
              + (typeAfter == "love" ? 1 : 0)
              - (typeBefore == "love" ? 1 : 0)
          && countsAfter.get("laugh", 0)
            == countsBefore.get("laugh", 0)
              + (typeAfter == "laugh" ? 1 : 0)
              - (typeBefore == "laugh" ? 1 : 0)
          && countsAfter.get("celebrate", 0)
            == countsBefore.get("celebrate", 0)
              + (typeAfter == "celebrate" ? 1 : 0)
              - (typeBefore == "celebrate" ? 1 : 0)
          && countsAfter.get("support", 0)
            == countsBefore.get("support", 0)
              + (typeAfter == "support" ? 1 : 0)
              - (typeBefore == "support" ? 1 : 0)
          && countsAfter.get("helpful", 0)
            == countsBefore.get("helpful", 0)
              + (typeAfter == "helpful" ? 1 : 0)
              - (typeBefore == "helpful" ? 1 : 0);
      }

      /*
       * A post reaction and the aggregate reactionCounts update must
       * happen in the same atomic batch. This prevents users from
       * changing aggregate counts without changing their own reaction.
       */
      function isValidPostReactionCountUpdate() {
        let reactionPath = /databases/$(database)/documents/communityPosts/$(postId)/reactions/$(request.auth.uid);
        let reactionExistsBefore = exists(reactionPath);
        let reactionExistsAfter = existsAfter(reactionPath);
        let typeBefore = reactionExistsBefore
          ? get(reactionPath).data.get("type", "")
          : "";
        let typeAfter = reactionExistsAfter
          ? getAfter(reactionPath).data.get("type", "")
          : "";
        let countsBefore = resource.data.get("reactionCounts", {});
        let countsAfter = request.resource.data.get("reactionCounts", {});

        return isAuthenticated()
          && isPublishedAndApprovedPost()
          && canSeeCommunityScope(postScope())
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["reactionCounts", "updatedAt"])
          && (reactionExistsBefore != reactionExistsAfter
            || typeBefore != typeAfter)
          && countsBefore is map
          && countsAfter is map
          && reactionCountsMatchTransition(
            countsBefore,
            countsAfter,
            typeBefore,
            typeAfter
          );
      }

      /*
       * Comment creation updates commentCount and records the new
       * comment ID in lastCommentId in the same batch. The child write
       * rule verifies the reciprocal parent update, so a caller cannot
       * increase commentCount independently of creating a comment.
       */
      function isValidCommentCountUpdate() {
        let newCommentId = request.resource.data.get("lastCommentId", "");

        return isAuthenticated()
          && isPublishedAndApprovedPost()
          && canSeeCommunityScope(postScope())
          && newCommentId is string
          && newCommentId.size() > 0
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "commentCount",
              "lastCommentId",
              "updatedAt"
            ])
          && request.resource.data.get("commentCount", 0)
            == resource.data.get("commentCount", 0) + 1
          && !exists(
            /databases/$(database)/documents/communityPosts/$(postId)/comments/$(newCommentId)
          )
          && existsAfter(
            /databases/$(database)/documents/communityPosts/$(postId)/comments/$(newCommentId)
          )
          && getAfter(
            /databases/$(database)/documents/communityPosts/$(postId)/comments/$(newCommentId)
          ).data.get("authorId", "") == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/communityPosts/$(postId)/comments/$(newCommentId)
          ).data.get("postId", "") == postId
          && getAfter(
            /databases/$(database)/documents/communityPosts/$(postId)/comments/$(newCommentId)
          ).data.get("status", "") == "published"
          && getAfter(
            /databases/$(database)/documents/communityPosts/$(postId)/comments/$(newCommentId)
          ).data.get("content", "") is string
          && getAfter(
            /databases/$(database)/documents/communityPosts/$(postId)/comments/$(newCommentId)
          ).data.get("content", "").size() > 0;
      }

      // Feeds read published, approved posts in a scope the user can see.
      // Authors read their own posts; moderators read hidden posts.
      // Feed queries must filter on organizationId (null for public).
      allow read: if isAuthenticated()
        && canSeeCommunityScope(postScope())
        && (
          isPublishedAndApprovedPost()
          || resource.data.get("authorId", "") == request.auth.uid
          || canModerateCommunityScope(postScope())
        );

      allow create: if isValidNewPost();

      // Engagement counters (validated batches), author edits and
      // deletes, and moderation. Ranking and view counts are server-side.
      allow update: if isValidPostReactionCountUpdate()
        || isValidCommentCountUpdate()
        || isAuthorEditingPost()
        || isAuthorDeletingPost()
        || isModeratingPost();

      // Posts are soft-deleted (status "deleted"); hard deletes stay server-side.
      allow delete: if false;

      // ============================================================
      // POST REACTIONS
      // ============================================================

      match /reactions/{userId} {

        function parentPostIsPublished() {
          return communityPostIsOpen(postId);
        }

        function postCounterMatchesReactionTransition() {
          let postPath = /databases/$(database)/documents/communityPosts/$(postId);
          let reactionPath = /databases/$(database)/documents/communityPosts/$(postId)/reactions/$(userId);
          let postBefore = get(postPath).data;
          let postAfter = getAfter(postPath).data;
          let reactionExistsBefore = exists(reactionPath);
          let reactionExistsAfter = existsAfter(reactionPath);
          let typeBefore = reactionExistsBefore
            ? get(reactionPath).data.get("type", "")
            : "";
          let typeAfter = reactionExistsAfter
            ? getAfter(reactionPath).data.get("type", "")
            : "";
          let countsBefore = postBefore.get("reactionCounts", {});
          let countsAfter = postAfter.get("reactionCounts", {});

          return postAfter.diff(postBefore).affectedKeys()
              .hasOnly(["reactionCounts", "updatedAt"])
            && (reactionExistsBefore != reactionExistsAfter
              || typeBefore != typeAfter)
            && countsBefore is map
            && countsAfter is map
            && countsAfter.get("like", 0)
              == countsBefore.get("like", 0)
                + (typeAfter == "like" ? 1 : 0)
                - (typeBefore == "like" ? 1 : 0)
            && countsAfter.get("love", 0)
              == countsBefore.get("love", 0)
                + (typeAfter == "love" ? 1 : 0)
                - (typeBefore == "love" ? 1 : 0)
            && countsAfter.get("laugh", 0)
              == countsBefore.get("laugh", 0)
                + (typeAfter == "laugh" ? 1 : 0)
                - (typeBefore == "laugh" ? 1 : 0)
            && countsAfter.get("celebrate", 0)
              == countsBefore.get("celebrate", 0)
                + (typeAfter == "celebrate" ? 1 : 0)
                - (typeBefore == "celebrate" ? 1 : 0)
            && countsAfter.get("support", 0)
              == countsBefore.get("support", 0)
                + (typeAfter == "support" ? 1 : 0)
                - (typeBefore == "support" ? 1 : 0)
            && countsAfter.get("helpful", 0)
              == countsBefore.get("helpful", 0)
                + (typeAfter == "helpful" ? 1 : 0)
                - (typeBefore == "helpful" ? 1 : 0);
        }

        allow get: if isAuthenticated()
          && request.auth.uid == userId
          && parentPostIsPublished();

        // The feed reads each user's reaction by document ID.
        allow list: if false;

        allow create: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.get("type", "") in [
            "like", "love", "laugh", "celebrate", "support", "helpful"
          ]
          && (
            !request.resource.data.keys().hasAny(["userId"])
            || request.resource.data.get("userId", "") == userId
          )
          && parentPostIsPublished()
          && postCounterMatchesReactionTransition();

        allow update: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.get("type", "") in [
            "like", "love", "laugh", "celebrate", "support", "helpful"
          ]
          && (
            !request.resource.data.keys().hasAny(["userId"])
            || request.resource.data.get("userId", "") == userId
          )
          && parentPostIsPublished()
          && postCounterMatchesReactionTransition();

        allow delete: if isAuthenticated()
          && request.auth.uid == userId
          && parentPostIsPublished()
          && postCounterMatchesReactionTransition();
      }

      // ============================================================
      // COMMENTS
      // ============================================================

      match /comments/{commentId} {

        function parentPostIsPublished() {
          return communityPostIsOpen(postId);
        }

        function isValidCommentReactionCountUpdate() {
          let reactionPath = /databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)/reactions/$(request.auth.uid);
          let reactionExistsBefore = exists(reactionPath);
          let reactionExistsAfter = existsAfter(reactionPath);
          let typeBefore = reactionExistsBefore
            ? get(reactionPath).data.get("type", "")
            : "";
          let typeAfter = reactionExistsAfter
            ? getAfter(reactionPath).data.get("type", "")
            : "";
          let countsBefore = resource.data.get("reactionCounts", {});
          let countsAfter = request.resource.data.get("reactionCounts", {});

          return isAuthenticated()
            && parentPostIsPublished()
            && resource.data.get("status", "") == "published"
            && request.resource.data.get("status", "") == "published"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["reactionCounts", "updatedAt"])
            && (reactionExistsBefore != reactionExistsAfter
              || typeBefore != typeAfter)
            && countsBefore is map
            && countsAfter is map
            && countsAfter.get("like", 0)
              == countsBefore.get("like", 0)
                + (typeAfter == "like" ? 1 : 0)
                - (typeBefore == "like" ? 1 : 0)
            && countsAfter.get("love", 0)
              == countsBefore.get("love", 0)
                + (typeAfter == "love" ? 1 : 0)
                - (typeBefore == "love" ? 1 : 0)
            && countsAfter.get("laugh", 0)
              == countsBefore.get("laugh", 0)
                + (typeAfter == "laugh" ? 1 : 0)
                - (typeBefore == "laugh" ? 1 : 0)
            && countsAfter.get("celebrate", 0)
              == countsBefore.get("celebrate", 0)
                + (typeAfter == "celebrate" ? 1 : 0)
                - (typeBefore == "celebrate" ? 1 : 0)
            && countsAfter.get("support", 0)
              == countsBefore.get("support", 0)
                + (typeAfter == "support" ? 1 : 0)
                - (typeBefore == "support" ? 1 : 0)
            && countsAfter.get("helpful", 0)
              == countsBefore.get("helpful", 0)
                + (typeAfter == "helpful" ? 1 : 0)
                - (typeBefore == "helpful" ? 1 : 0);
        }

        function isAuthorSoftDeletingComment() {
          return isAuthenticated()
            && (
              resource.data.get("authorId", "") == request.auth.uid
              || canModerateCommunityScope(
                communityScopeOf(get(communityPostPath(postId)).data)
              )
            )
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["content", "status", "deletedAt", "updatedAt"])
            && request.resource.data.get("postId", "")
              == resource.data.get("postId", "")
            && request.resource.data.get("authorId", "")
              == resource.data.get("authorId", "")
            && request.resource.data.get("status", "") == "deleted"
            && request.resource.data.get("content", "") == "";
        }

        // The feed/detail page may read published and soft-deleted comments.
        // Soft-deleted records remain available so their replies can render.
        allow get, list: if isAuthenticated()
          && parentPostIsPublished();

        // Comments must be authored by the signed-in user, and their
        // creation must atomically update the parent post's count.
        allow create: if isAuthenticated()
          && parentPostIsPublished()
          && request.resource.data.keys().hasAll([
            "postId",
            "parentCommentId",
            "authorId",
            "author",
            "content",
            "reactionCounts",
            "status",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.get("postId", "") == postId
          && request.resource.data.get("authorId", "") == request.auth.uid
          && request.resource.data.get("author", {}) is map
          && request.resource.data.get("author", {}).get("id", "")
            == request.auth.uid
          && request.resource.data.get("content", "") is string
          && request.resource.data.get("content", "").size() > 0
          && request.resource.data.get("content", "").size() <= 2000
          && request.resource.data.get("status", "") == "published"
          && request.resource.data.get("reactionCounts", {}) is map
          && (
            request.resource.data.get("parentCommentId", null) == null
            || request.resource.data.get("parentCommentId", null) is string
          )
          && getAfter(
            /databases/$(database)/documents/communityPosts/$(postId)
          ).data.get("lastCommentId", "") == commentId
          && getAfter(
            /databases/$(database)/documents/communityPosts/$(postId)
          ).data.get("commentCount", 0)
            == get(
              /databases/$(database)/documents/communityPosts/$(postId)
            ).data.get("commentCount", 0) + 1;

        // Aggregate reaction updates are allowed only when an associated
        // reaction document changes in the same atomic batch.
        allow update: if isValidCommentReactionCountUpdate()
          || isAuthorSoftDeletingComment();

        // The client uses soft deletion. Permanent deletion stays server-side.
        allow delete: if false;

        // ============================================================
        // COMMENT REACTIONS
        // ============================================================

        match /reactions/{userId} {

          function parentCommentIsAvailable() {
            let commentPath = /databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId);
            return communityPostIsOpen(postId)
              && exists(commentPath)
              && get(commentPath).data.get("status", "") == "published";
          }

          function commentCounterMatchesReactionTransition() {
            let commentPath = /databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId);
            let reactionPath = /databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)/reactions/$(userId);
            let reactionExistsBefore = exists(reactionPath);
            let reactionExistsAfter = existsAfter(reactionPath);
            let typeBefore = reactionExistsBefore
              ? get(reactionPath).data.get("type", "")
              : "";
            let typeAfter = reactionExistsAfter
              ? getAfter(reactionPath).data.get("type", "")
              : "";
            let commentBefore = get(commentPath).data;
            let commentAfter = getAfter(commentPath).data;
            let countsBefore = commentBefore.get("reactionCounts", {});
            let countsAfter = commentAfter.get("reactionCounts", {});

            return commentAfter.diff(commentBefore).affectedKeys()
                .hasOnly(["reactionCounts", "updatedAt"])
              && (reactionExistsBefore != reactionExistsAfter
                || typeBefore != typeAfter)
              && countsBefore is map
              && countsAfter is map
              && countsAfter.get("like", 0)
                == countsBefore.get("like", 0)
                  + (typeAfter == "like" ? 1 : 0)
                  - (typeBefore == "like" ? 1 : 0)
              && countsAfter.get("love", 0)
                == countsBefore.get("love", 0)
                  + (typeAfter == "love" ? 1 : 0)
                  - (typeBefore == "love" ? 1 : 0)
              && countsAfter.get("laugh", 0)
                == countsBefore.get("laugh", 0)
                  + (typeAfter == "laugh" ? 1 : 0)
                  - (typeBefore == "laugh" ? 1 : 0)
              && countsAfter.get("celebrate", 0)
                == countsBefore.get("celebrate", 0)
                  + (typeAfter == "celebrate" ? 1 : 0)
                  - (typeBefore == "celebrate" ? 1 : 0)
              && countsAfter.get("support", 0)
                == countsBefore.get("support", 0)
                  + (typeAfter == "support" ? 1 : 0)
                  - (typeBefore == "support" ? 1 : 0)
              && countsAfter.get("helpful", 0)
                == countsBefore.get("helpful", 0)
                  + (typeAfter == "helpful" ? 1 : 0)
                  - (typeBefore == "helpful" ? 1 : 0);
          }

          allow get: if isAuthenticated()
            && request.auth.uid == userId
            && parentCommentIsAvailable();

          allow list: if false;

          allow create: if isAuthenticated()
            && request.auth.uid == userId
            && request.resource.data.get("userId", "") == userId
            && request.resource.data.get("type", "") in [
              "like", "love", "laugh", "celebrate", "support", "helpful"
            ]
            && parentCommentIsAvailable()
            && commentCounterMatchesReactionTransition();

          allow update: if isAuthenticated()
            && request.auth.uid == userId
            && request.resource.data.get("userId", "") == userId
            && request.resource.data.get("type", "") in [
              "like", "love", "laugh", "celebrate", "support", "helpful"
            ]
            && parentCommentIsAvailable()
            && commentCounterMatchesReactionTransition();

          allow delete: if isAuthenticated()
            && request.auth.uid == userId
            && parentCommentIsAvailable()
            && commentCounterMatchesReactionTransition();
        }
      }
    }

    // ============================================================
    // COMMUNITY BOOKMARKS
    // ============================================================

    match /users/{userId}/communityBookmarks/{postId} {

      allow read: if isAuthenticated()
        && request.auth.uid == userId;

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.get("userId", "") == userId
        && request.resource.data.get("postId", "") == postId
        && communityPostIsOpen(postId);

      allow update: if false;

      allow delete: if isAuthenticated()
        && request.auth.uid == userId;
    }

    // ============================================================
    // COMMUNITY FOLLOW RELATIONSHIPS
    // ============================================================

    match /userFollows/{followId} {

      allow get: if isAuthenticated()
        && (
          !exists(
            /databases/$(database)/documents/userFollows/$(followId)
          )
          || resource.data.get("followerId", "") == request.auth.uid
          || resource.data.get("followingId", "") == request.auth.uid
        );

      allow list: if isAuthenticated()
        && (
          resource.data.get("followerId", "") == request.auth.uid
          || resource.data.get("followingId", "") == request.auth.uid
        );

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll([
          "followerId", "followingId", "createdAt"
        ])
        && request.resource.data.get("followerId", "") == request.auth.uid
        && request.resource.data.get("followingId", "") is string
        && request.resource.data.get("followingId", "") != request.auth.uid
        && followId == request.auth.uid
          + "_"
          + request.resource.data.get("followingId", "");

      allow update: if false;

      allow delete: if isAuthenticated()
        && resource.data.get("followerId", "") == request.auth.uid
        && followId == request.auth.uid
          + "_"
          + resource.data.get("followingId", "");
    }

    // ============================================================
    // COMMUNITY TOPICS
    // ============================================================

    function isValidCommunityTopic(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.slug is string
        && data.slug.size() > 0
        && data.slug.size() <= 80
        && data.active is bool
        && data.get("sortOrder", 0) is number;
    }

    // Public Zebron Community topics: platform administrators manage.
    match /communityTopics/{topicId} {
      allow read: if isAuthenticated();
      allow create, update: if isPlatformAdmin()
        && isValidCommunityTopic(request.resource.data);
      allow delete: if isPlatformAdmin();
    }

    // Organization community topics: members read; managers+ manage.
    match /organizations/{organizationId}/communityTopics/{topicId} {
      allow read: if canSeeCommunityScope(organizationId);
      allow create, update: if canModerateCommunityScope(organizationId)
        && isValidCommunityTopic(request.resource.data);
      allow delete: if canModerateCommunityScope(organizationId);
    }

    // ============================================================
    // COMMUNITY REPORTS
    // ============================================================

    /*
     * One report per person per post: communityReports/{uid}_{postId}.
     * organizationId copies the post's scope so the right moderators
     * see it (managers+ of that organization, or platform admins for
     * the public Community). Reporters can read their own reports.
     */
    match /communityReports/{reportId} {

      allow get, list: if isAuthenticated()
        && (
          resource.data.reporterId == request.auth.uid
          || canModerateCommunityScope(resource.data.organizationId)
        );

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll([
          "postId",
          "organizationId",
          "reason",
          "reporterId",
          "status",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "postId",
          "commentId",
          "organizationId",
          "reason",
          "details",
          "reporterId",
          "reporterName",
          "postTitle",
          "status",
          "createdAt"
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && reportId == request.auth.uid + "_" + request.resource.data.postId
        && request.resource.data.reason in [
          "spam",
          "harassment",
          "inappropriate",
          "misinformation",
          "other"
        ]
        && request.resource.data.get("details", "") is string
        && request.resource.data.get("details", "").size() <= 1000
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time
        && exists(communityPostPath(request.resource.data.postId))
        && request.resource.data.organizationId
          == communityScopeOf(get(communityPostPath(request.resource.data.postId)).data)
        && canSeeCommunityScope(request.resource.data.organizationId);

      allow update: if isAuthenticated()
        && canModerateCommunityScope(resource.data.organizationId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "resolvedBy", "resolvedAt", "resolution"])
        && request.resource.data.status in ["open", "resolved", "dismissed"]
        && request.resource.data.get("resolvedBy", "") == request.auth.uid;

      allow delete: if false;
    }

    // ============================================================
    // COMMUNITY NOTIFICATIONS
    // ============================================================

    match /communityNotifications/{notificationId} {

      allow get, list: if isAuthenticated()
        && resource.data.get("recipientId", "") == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.get("recipientId", "") is string
        && request.resource.data.get("recipientId", "") != request.auth.uid
        && (
          request.resource.data.get("actorId", "") == request.auth.uid
          || isPlatformAdmin()
        );

      allow update: if isAuthenticated()
        && resource.data.get("recipientId", "") == request.auth.uid
        && request.resource.data.get("recipientId", "")
          == resource.data.get("recipientId", "")
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["read", "readAt"]);

      allow delete: if false;
    }

    // ============================================================
    // COMMUNITY CHAT CONVERSATIONS
    // ============================================================

    match /communityConversations/{conversationId} {

      function isConversationParticipant() {
        return isAuthenticated()
          && resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds;
      }

      // Only conversation participants can read the conversation.
      allow get, list: if isConversationParticipant();

      // Start a direct conversation between yourself and one other person.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll([
          "type",
          "participantIds",
          "participantInfo",
          "unreadCounts",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.type == "direct"
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0]
          != request.resource.data.participantIds[1]
        && request.resource.data.participantInfo is list
        && request.resource.data.participantInfo.size() == 2
        && request.resource.data.unreadCounts is map
        && request.resource.data.get("lastMessage", "") == ""
        && request.resource.data.createdAt == request.time;

      // Sending a message updates the conversation summary in the same
      // transaction. The sender's own unread count never increases.
      function isSenderUpdatingSummary() {
        return isConversationParticipant()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "lastMessage",
              "lastMessageSenderId",
              "lastMessageAt",
              "unreadCounts",
              "updatedAt"
            ])
          && request.resource.data.lastMessageSenderId == request.auth.uid
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 5000
          && request.resource.data.unreadCounts is map
          && request.resource.data.unreadCounts.get(request.auth.uid, 0)
            <= resource.data.get("unreadCounts", {}).get(request.auth.uid, 0)
          && request.resource.data.participantIds == resource.data.participantIds;
      }

      // Reading one message lowers your own unread count by one.
      function isReaderLoweringOwnCount() {
        return isConversationParticipant()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["unreadCounts", "updatedAt"])
          && request.resource.data.unreadCounts is map
          && request.resource.data.unreadCounts.get(request.auth.uid, -1) >= 0
          && request.resource.data.unreadCounts.get(request.auth.uid, 0)
            <= resource.data.get("unreadCounts", {}).get(request.auth.uid, 0)
          && (
            !resource.data.keys().hasAny(["unreadCounts"])
            || request.resource.data.unreadCounts
              .diff(resource.data.unreadCounts)
              .affectedKeys()
              .hasOnly([request.auth.uid])
          );
      }

      // Allow a participant to mark their own conversation as read.
      //
      // The update may change only:
      // - unreadCounts
      // - updatedAt
      //
      // The participant can change only their own unread-count entry.
      allow update: if isSenderUpdatingSummary()
        || isReaderLoweringOwnCount()
        || isConversationParticipant()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['unreadCounts', 'updatedAt'])
        && request.resource.data.unreadCounts is map
        && request.resource.data.unreadCounts
          .get(request.auth.uid, -1) == 0
        && (
          // Support older conversations with no unreadCounts map.
          (
            !resource.data.keys().hasAny(['unreadCounts'])
            && request.resource.data.unreadCounts.keys()
              .hasOnly([request.auth.uid])
          )

          ||

          // Otherwise, only this participant's entry may change.
          (
            resource.data.unreadCounts is map
            && request.resource.data.unreadCounts
              .diff(resource.data.unreadCounts)
              .affectedKeys()
              .hasOnly([request.auth.uid])
          )
        );

      // ==========================================================
      // COMMUNITY CHAT MESSAGES
      // ==========================================================

      match /messages/{messageId} {

        function isParentConversationParticipant() {
          let conversationPath =
            /databases/$(database)/documents/communityConversations/$(conversationId);

          return isAuthenticated()
            && exists(conversationPath)
            && request.auth.uid in
              get(conversationPath).data.participantIds;
        }

        // Only participants can read messages.
        allow get, list: if isParentConversationParticipant();

        // Participants send messages as themselves.
        allow create: if isParentConversationParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.conversationId == conversationId
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 5000
          && request.resource.data.type
            in ["text", "image", "video", "audio", "file"]
          && request.resource.data.status == "sent"
          && request.resource.data.readBy == [request.auth.uid]
          && (
            request.resource.data.get("attachment", null) == null
            || request.resource.data.attachment is map
          )
          && request.resource.data.createdAt == request.time;

        // Other participants mark a message read (adds themselves to readBy).
        allow update: if isParentConversationParticipant()
          && resource.data.get("senderId", "") != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["readBy", "status", "updatedAt"])
          && request.resource.data.status == "read"
          && request.resource.data.readBy is list
          && request.resource.data.readBy.toSet()
            .difference(resource.data.get("readBy", []).toSet())
            == [request.auth.uid].toSet()
          && request.resource.data.readBy.toSet()
            .hasAll(resource.data.get("readBy", []).toSet());

        allow delete: if false;
      }
    }

    // ============================================================
    // COMMUNITY CHAT CALLS
    // ============================================================

    match /communityChatCalls/{callId} {

      function isCallParticipant() {
        return isAuthenticated()
          && (
            resource.data.get('callerId', '') == request.auth.uid
            || resource.data.get('calleeId', '') == request.auth.uid
          );
      }

      function conversationContainsBothParticipants(
        conversationId,
        callerId,
        calleeId
      ) {
        let conversationPath =
          /databases/$(database)/documents/communityConversations/$(conversationId);

        return exists(conversationPath)
          && get(conversationPath).data.get('participantIds', []) is list
          && callerId in get(conversationPath).data.participantIds
          && calleeId in get(conversationPath).data.participantIds;
      }

      // A caller or callee can read an individual call.
      allow get: if isCallParticipant();

      // Incoming-call listener:
      // Only the intended recipient can list their ringing calls.
      allow list: if isAuthenticated()
        && resource.data.get('calleeId', '') == request.auth.uid
        && resource.data.get('status', '') == 'ringing';

      // Only a conversation participant can initiate a call,
      // and the call must identify both participants correctly.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll([
          'conversationId',
          'callerId',
          'calleeId',
          'type',
          'status',
          'offer',
          'answer',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.get('callerId', '') == request.auth.uid
        && request.resource.data.get('calleeId', '') is string
        && request.resource.data.get('calleeId', '') != request.auth.uid
        && request.resource.data.get('conversationId', '') is string
        && request.resource.data.get('type', '') in ['voice', 'video']
        && request.resource.data.get('status', '') == 'ringing'
        && request.resource.data.get('offer', null) == null
        && request.resource.data.get('answer', null) == null
        && conversationContainsBothParticipants(
          request.resource.data.conversationId,
          request.resource.data.callerId,
          request.resource.data.calleeId
        );

      // Allow only the defined call-signaling transitions.
      // Call participants, conversation identity, and creation time
      // cannot be changed after creation.
      allow update: if isCallParticipant()
        && request.resource.data.get('conversationId', '')
          == resource.data.get('conversationId', '')
        && request.resource.data.get('callerId', '')
          == resource.data.get('callerId', '')
        && request.resource.data.get('calleeId', '')
          == resource.data.get('calleeId', '')
        && request.resource.data.get('type', '')
          == resource.data.get('type', '')
        && request.resource.data.get('createdAt', null)
          == resource.data.get('createdAt', null)
        && (
          // Caller publishes the WebRTC offer.
          (
            request.auth.uid == resource.data.get('callerId', '')
            && resource.data.get('status', '') == 'ringing'
            && request.resource.data.get('status', '') == 'ringing'
            && request.resource.data.get('offer', null) is map
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['offer', 'updatedAt'])
          )

          ||

          // Recipient accepts and supplies the answer.
          (
            request.auth.uid == resource.data.get('calleeId', '')
            && resource.data.get('status', '') == 'ringing'
            && request.resource.data.get('status', '') == 'accepted'
            && request.resource.data.get('answer', null) is map
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'answer', 'updatedAt'])
          )

          ||

          // Recipient declines a ringing call.
          (
            request.auth.uid == resource.data.get('calleeId', '')
            && resource.data.get('status', '') == 'ringing'
            && request.resource.data.get('status', '') == 'declined'
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          )

          ||

          // Either participant can end an active or ringing call.
          // The caller can also mark a ringing call as missed.
          (
            resource.data.get('status', '') in ['ringing', 'accepted']
            && request.resource.data.get('status', '') in ['ended', 'missed']
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          )
        );

      // ==========================================================
      // WEBRTC ICE CANDIDATES
      // ==========================================================

      match /candidates/{candidateId} {

        function isParentCallParticipant() {
          let callPath =
            /databases/$(database)/documents/communityChatCalls/$(callId);

          return isAuthenticated()
            && exists(callPath)
            && (
              get(callPath).data.get('callerId', '') == request.auth.uid
              || get(callPath).data.get('calleeId', '') == request.auth.uid
            );
        }

        // Only participants can receive signaling candidates.
        allow get, list: if isParentCallParticipant();

        // Each participant can publish only their own candidate.
        allow create: if isParentCallParticipant()
          && request.resource.data.get('senderId', '')
            == request.auth.uid
          && request.resource.data.get('candidate', null) is map;

        allow update, delete: if false;
      }
    }

    // ============================================================
    // QA HUB
    // ============================================================

    /**
     * An active QA tester must have an administrator-managed
     * qaTesters/{userId} document with active == true.
     *
     * Users cannot activate their own tester access.
     */
    function isActiveQaTester() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/qaTesters/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/qaTesters/$(request.auth.uid)
        ).data.get("active", false) == true;
    }

    /**
     * Verify that the authenticated user is assigned to
     * the specified QA task.
     */
    function isAssignedQaTask(taskId) {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/qaTasks/$(taskId)
        )
        && request.auth.uid in get(
          /databases/$(database)/documents/qaTasks/$(taskId)
        ).data.get("assignedTesterIds", []);
    }

    // ============================================================
    // QA TESTERS
    // ============================================================

    match /qaTesters/{userId} {

      // Administrators can inspect tester records.
      // Testers can retrieve only their own active record.
      allow get: if isPlatformAdmin()
        || (
          isCurrentUser(userId)
          && resource.data.get("active", false) == true
        );

      // Only administrators can list tester records.
      allow list: if isPlatformAdmin();

      // Only administrators can activate, deactivate,
      // create, or delete tester records.
      allow create, update, delete: if isPlatformAdmin();
    }

    // ============================================================
    // QA TASKS
    // ============================================================

    match /qaTasks/{taskId} {

      // Administrators can access all QA tasks.
      // Testers can access only tasks assigned to them.
      allow get, list: if isPlatformAdmin()
        || (
          isActiveQaTester()
          && request.auth.uid in resource.data.get(
            "assignedTesterIds", []
          )
        );

      // Only platform administrators can create tasks.
      allow create: if isPlatformAdmin()
        && request.resource.data.keys().hasAll([
          "title",
          "description",
          "application",
          "instructions",
          "expectedResult",
          "assignedTesterIds",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.application is string
        && request.resource.data.instructions is string
        && request.resource.data.expectedResult is string
        && request.resource.data.assignedTesterIds is list
        && request.resource.data.status == "open"
        && request.resource.data.createdBy == request.auth.uid;

      // Only administrators can update tasks.
      // Preserve the original creator.
      allow update: if isPlatformAdmin()
        && request.resource.data.createdBy
          == resource.data.createdBy;

      // Only administrators can delete tasks.
      allow delete: if isPlatformAdmin();
    }

    // ============================================================
    // QA SUBMISSIONS
    // ============================================================

    match /qaSubmissions/{submissionId} {

      // Administrators can review all submissions.
      // Testers can access only their own submissions.
      allow get, list: if isPlatformAdmin()
        || (
          isActiveQaTester()
          && resource.data.testerId == request.auth.uid
        );

      // Active testers can submit results only for tasks
      // assigned to them.
      allow create: if isActiveQaTester()
        && request.resource.data.keys().hasAll([
          "taskId",
          "testerId",
          "result",
          "feedback",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "taskId",
          "testerId",
          "result",
          "feedback",
          "createdAt"
        ])
        && request.resource.data.testerId == request.auth.uid
        && request.resource.data.taskId is string
        && request.resource.data.result in [
          "pass",
          "fail",
          "blocked"
        ]
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() <= 10000
        && isAssignedQaTask(
          request.resource.data.taskId
        )
        && get(
          /databases/$(database)/documents/qaTasks/$(request.resource.data.taskId)
        ).data.get("status", "") != "closed";

      // Submitted results cannot be modified or deleted by
      // testers. Administrators can correct or remove them.
      allow update, delete: if isPlatformAdmin();
    }

        // ============================================================
    // AUDIT LOGS
    // ============================================================

    /*
     * Append-only audit trail written by AuditService.
     *
     * - Signed-in users may create records only about themselves.
     * - Only platform admins may record actorType "admin".
     * - createdAt must be the server timestamp.
     * - Records can never be modified or deleted from the client.
     * - Only platform admins may read them.
     *
     * Anonymous events (e.g. failed sign-ins) are rejected here;
     * record those from a trusted Cloud Function if needed.
     */
    match /auditLogs/{auditId} {

      function isValidAuditRecord(data) {
        return data.keys().hasOnly([
            "action",
            "entityType",
            "entityId",
            "actorId",
            "actorName",
            "actorEmail",
            "actorType",
            "outcome",
            "source",
            "reason",
            "metadata",
            "before",
            "after",
            "createdAt"
          ])
          && data.keys().hasAll([
            "action",
            "entityType",
            "actorId",
            "actorType",
            "outcome",
            "source",
            "createdAt"
          ])
          && data.action is string
          && data.action.size() > 0
          && data.action.size() <= 200
          && data.entityType is string
          && data.entityType.size() > 0
          && (data.get("entityId", null) == null
            || data.get("entityId", null) is string)
          && (data.get("actorName", null) == null
            || data.get("actorName", null) is string)
          && (data.get("actorEmail", null) == null
            || data.get("actorEmail", null) is string)
          && (data.get("reason", null) == null
            || data.get("reason", null) is string)
          && data.get("metadata", {}) is map
          && data.outcome in [
            "success",
            "failure",
            "denied",
            "cancelled"
          ]
          && data.source == "web"
          && data.createdAt == request.time;
      }

      allow get, list: if isPlatformAdmin();

      allow create: if isAuthenticated()
        && isValidAuditRecord(request.resource.data)
        && request.resource.data.actorId == request.auth.uid
        && (
          request.resource.data.actorType == "user"
          || (
            request.resource.data.actorType == "admin"
            && isPlatformAdmin()
          )
        );

      // Audit records are immutable.
      allow update, delete: if false;
    }

    // ============================================================
    // SUPPORT TICKETS AND CONTRACTS (server-only)
    // ============================================================

    /*
     * Support tickets, contracts and service requests are read and
     * written only through Cloud Functions, which check who may see
     * each record. Browsers have no direct access.
     */
    match /supportTickets/{ticketId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Help assistant usage counters (rate limiting).
    match /assistantUsage/{usageId} {
      allow read, write: if false;
    }

    match /organizationServiceRequests/{requestId} {
      allow read, write: if false;
    }

    match /contractTerms/{document=**} {
      allow read, write: if false;
    }

    match /organizations/{organizationId}/contract/{contractId} {
      allow read, write: if false;
    }

    // ============================================================
    // ORGANIZATION AUDIT LOG
    // ============================================================

    /*
     * Written only by the audit Cloud Function triggers.
     * Organization admins and owners (and platform admins) can read
     * their organization's log. Nobody can change or delete entries.
     */
    match /organizations/{organizationId}/auditLogs/{eventId} {
      allow get, list: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId)
          && isOrganizationAdmin(organizationId)
        );

      allow create, update, delete: if false;
    }

    // ============================================================
    // ORGANIZATION ANNOUNCEMENTS (dashboard banners)
    // ============================================================

    /*
     * Banners for upcoming events, new cohorts, graduations and
     * student shout-outs, shown on the organization dashboard.
     *
     * - Every active member can read active banners.
     * - Managers, admins and owners can read, create, edit and delete.
     * - Writes are validated: known types/themes/fonts/artwork only,
     *   length limits, and https-only links.
     */
    match /organizations/{organizationId}/announcements/{announcementId} {

      function isOptionalString(data, field, maxSize) {
        return data.get(field, null) == null
          || (data[field] is string && data[field].size() <= maxSize);
      }

      function isOptionalHttpsUrl(data, field) {
        return data.get(field, null) == null
          || (
            data[field] is string
            && data[field].size() <= 1000
            && data[field].matches("^https://.+")
          );
      }

      function isOptionalDate(data, field) {
        return data.get(field, null) == null
          || (
            data[field] is string
            && data[field].matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          );
      }

      function isValidAnnouncement(data) {
        return data.keys().hasOnly([
            "organizationId",
            "type",
            "title",
            "message",
            "ctaLabel",
            "ctaUrl",
            "eventDate",
            "honoreeName",
            "theme",
            "font",
            "artwork",
            "imageUrl",
            "startsOn",
            "endsOn",
            "active",
            "createdBy",
            "createdAt",
            "updatedAt"
          ])
          && data.organizationId == organizationId
          && data.type in ["event", "cohort", "graduation", "shoutout", "general"]
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 120
          && data.message is string
          && data.message.size() <= 500
          && data.theme in ["zebron", "sunrise", "royal", "midnight", "forest", "sky", "confetti", "gold"]
          && data.font in ["default", "serif", "rounded", "display", "mono"]
          && data.artwork in ["calendar", "celebration", "graduation", "trophy", "star", "groups", "rocket", "campaign", "school", "none"]
          && data.active is bool
          && isOptionalString(data, "ctaLabel", 40)
          && isOptionalString(data, "honoreeName", 80)
          && isOptionalHttpsUrl(data, "ctaUrl")
          && isOptionalHttpsUrl(data, "imageUrl")
          && isOptionalDate(data, "eventDate")
          && isOptionalDate(data, "startsOn")
          && isOptionalDate(data, "endsOn");
      }

      function canManageAnnouncements() {
        return isPlatformAdmin()
          || (
            isOrganizationOperational(organizationId)
            && isOrganizationManagerOrAbove(organizationId)
          );
      }

      allow get, list: if canManageAnnouncements()
        || (
          isOrganizationOperational(organizationId)
          && isOrganizationMember(organizationId)
          && resource.data.get("active", false) == true
        );

      allow create: if canManageAnnouncements()
        && isValidAnnouncement(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if canManageAnnouncements()
        && isValidAnnouncement(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get("createdAt", null)
          == resource.data.get("createdAt", null);

      allow delete: if canManageAnnouncements();
    }

    // ============================================================
    // ORGANIZATION INBOUND MESSAGES
    // ============================================================
 
    /*
     * Email sent to org+<slug>@zebron.org is stored here by the
     * receiveInboundEmail Cloud Function (Admin SDK, bypasses rules).
     *
     * - Organization owners, admins and managers can read their
     *   organization's mail and mark it read/archived.
     * - Platform administrators retain access for support.
     * - Clients can never create messages or change their content.
     * - Only platform administrators can permanently delete.
     */
    match /organizations/{organizationId}/inboundMessages/{messageId} {
 
      allow get, list: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId)
          && isOrganizationManagerOrAbove(organizationId)
        );
 
      allow create: if false;
 
      allow update: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId)
          && isOrganizationManagerOrAbove(organizationId)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["status", "read", "archived", "updatedAt"])
          && request.resource.data.get("status", "") in ["new", "read", "archived"]
        );
 
      allow delete: if isPlatformAdmin();
    }

    // ============================================================
    // ORGANIZATION SENT MESSAGES (mailbox)
    // ============================================================

    /*
     * Written only by the sendOrganizationMailboxEmail Cloud Function.
     * Managers, admins and owners can read the organization's sent mail.
     */
    match /organizations/{organizationId}/sentMessages/{messageId} {
      allow get, list: if isPlatformAdmin()
        || (
          isOrganizationConfigurable(organizationId)
          && isOrganizationManagerOrAbove(organizationId)
        );

      allow create, update, delete: if false;
    }

        // ============================================================
    // PLATFORM CONTACT MAILBOX
    // ============================================================

    /*
     * Written by trusted Cloud Functions (submitContactMessage,
     * receiveInboundEmail, sendContactReply) via the Admin SDK.
     * Platform administrators can read messages and update their
     * mailbox status. Clients never create or rewrite messages.
     */
    match /contactMessages/{messageId} {

      allow get, list: if isPlatformAdmin();

      allow create: if false;

      allow update: if isPlatformAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["status", "read", "archived", "updatedAt", "readAt", "archivedAt"]);

      allow delete: if isPlatformAdmin();

      match /replies/{replyId} {
        allow get, list: if isPlatformAdmin();
        allow create, update, delete: if false;
      }
    }

    // ============================================================
    // RESOURCES (public directory)
    // ============================================================

    /*
     * Anyone, signed in or not, can read published resources.
     * Drafts, pending and archived resources are visible to platform
     * administrators only, so every public query must filter on
     * status == "published". Only platform administrators write.
     */
    match /resources/{resourceId} {
      allow get, list: if resource.data.status == "published"
        || isPlatformAdmin();

      allow create, update: if isPlatformAdmin()
        && isValidResource();

      allow delete: if isPlatformAdmin();
    }

    function isValidResource() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.status in ["draft", "pending", "published", "archived"];
    }

    // ============================================================
    // CATEGORIES AND LOCATIONS (public lookup lists)
    // ============================================================

    /*
     * Used by the resource filters and resource pages, including for
     * people who are not signed in. Only platform administrators write.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    match /locations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    // ============================================================
    // RESOURCE SUBMISSIONS ("Submit a resource")
    // ============================================================

    /*
     * Signed-in people suggest resources. A submission always starts
     * as pending, belongs to the person who sent it and cannot carry
     * review fields. The submitter can read their own submissions;
     * platform administrators review, approve, reject and delete.
     */
    match /submissions/{submissionId} {
      allow get, list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.submittedBy == request.auth.uid
        );

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          "submittedBy",
          "resourceName",
          "description",
          "website",
          "categoryId",
          "organizationName",
          "location",
          "submitterEmail",
          "status",
          "createdAt"
        ])
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.resourceName is string
        && request.resource.data.resourceName.size() > 0
        && request.resource.data.resourceName.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000;

      allow update, delete: if isPlatformAdmin();
    }

    // ============================================================
    // JOBS (Job Finder)
    // ============================================================

    /*
     * Active jobs are public. A closed job can still be opened from an
     * old link; drafts are for platform administrators only. Lists must
     * filter on status == "active". Only platform administrators write.
     */
    match /jobs/{jobId} {
      allow get: if resource.data.status in ["active", "closed"]
        || isPlatformAdmin();

      allow list: if resource.data.status == "active"
        || isPlatformAdmin();

      allow create, update, delete: if isPlatformAdmin();
    }

        // ============================================================
    // RESOURCE TYPES (public lookup list)
    // ============================================================

    match /resourceTypes/{typeId} {
      allow get, list: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    // ============================================================
    // SYSTEM SETTINGS
    // ============================================================

    /*
     * Application-wide configuration loaded by SettingsService.
     * Readable by the app (it may be needed before sign-in, e.g.
     * feature flags). Never store secrets here — use Secret Manager.
     * Only platform administrators can change settings.
     */
    match /systemSettings/{settingKey} {
      allow get, list: if true;
      allow create, update, delete: if isPlatformAdmin();
    }

    // ============================================================
    // COURSE ENROLLMENTS
    // ============================================================

    /*
     * Users can read only their own enrollments.
     * Enrollments are created and changed by trusted backend code
     * or platform administrators.
     */
    match /courseEnrollments/{enrollmentId} {
      allow get, list: if isPlatformAdmin()
        || (
          isAuthenticated()
          && resource.data.get("userId", "") == request.auth.uid
        );

      allow create, update, delete: if isPlatformAdmin();
    }

    match /outboundMessages/{messageId} {
      allow get, list: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    /*
     * There is intentionally NO:
     *
     * match /{document=**} {
     *   allow read, write: if true;
     * }
     *
     * Any collection without an explicit rule is denied.
     *
     * Feature-specific rules can be added explicitly as required.
     */

  }
}
