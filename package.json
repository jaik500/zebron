{
  "name": "zebron",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:firestore": "vitest run tests/firestore",
    "rules:build": "node scripts/build-rules.mjs",
    "rules:check": "node scripts/build-rules.mjs --check",
    "rules:usage": "node scripts/rules-usage-report.mjs",
    "serve:ssr:zebron": "node dist/zebron/server/server.mjs",
    "generate:counties": "node scripts/generate-us-counties.mjs",
    "generate:application-inventory": "node scripts/generate-application-inventory.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.10.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/service-worker": "21.2.20",
    "@angular/ssr": "^21.1.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@ngrx/signals": "^21.1.1",
    "@ngxpert/hot-toast": "^6.4.1",
    "@tailwindcss/postcss": "^4.3.5",
    "codemirror": "^6.0.2",
    "express": "^5.3.0",
    "firebase-admin": "^13.10.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^6.2.108",
    "postcss": "^8.5.33",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.9.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.19",
    "firebase": "^13.4.0",
    "firebase-functions-test": "^3.5.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
